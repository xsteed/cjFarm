# 门店本地打印代理 — 示例配置
# 用法:复制本文件为 agent.env,与 print-agent 可执行文件放在同一目录,
#      按注释填写后运行程序即可(Windows 双击 exe 也读同目录 agent.env)。
# 完整部署手册见 ../../docs/print-agent.md(仓库根 docs 目录)。

# 云端地址:浏览器里打开管理后台的地址(不要带 /prod-api 和结尾斜杠)
PRINT_AGENT_SERVER=http://127.0.0.1:8080

# 代理令牌:管理端「系统配置 → 小票打印 → 本地打印代理 → 代理令牌」生成。
# v2 建议用「打印代理身份管理」逐台签发独立令牌,可单独吊销、可限定打印机范围。
PRINT_AGENT_TOKEN=换成你的代理令牌

# 轮询/长轮询等待秒数(默认 25):拉单请求会等新任务,出纸延迟亚秒级且更省请求;
# 门店网络差时可设为 0 退回纯轮询,或与 --interval 一起调。
PRINT_AGENT_WAIT=25

# 轮询间隔(秒,默认 3):长轮询模式下仅作为兜底节奏。
PRINT_AGENT_INTERVAL=3

# 单次最多取几条任务(默认 10,上限 50),一般无需修改。
# PRINT_AGENT_LIMIT=10

# 代理标识:多台代理时可区分是谁取的;默认取主机名。
PRINT_AGENT_NAME=门店收银电脑

# 仅当云端用自签证书(浏览器提示不安全)时才需要打开
# PRINT_AGENT_INSECURE=1

# 本地状态文件(幂等去重):默认取运行数据目录 print-agent.state,一般无需修改。
# PRINT_AGENT_STATE=print-agent.state
# PRINT_AGENT_LOG=print-agent.log  # 日志落盘(--install 默认开启;排障看此文件)

# 运行数据目录(agent.env / 状态 / 日志的落点):
#   默认 = 程序同目录;macOS 上用 --install 装成 App 后,默认变为
#   ~/Library/Application Support/PrintAgent(数据不放进 App,以免破坏代码签名)。
# 一般无需修改。
# PRINT_AGENT_DATA_DIR=/path/to/data

# 调试日志:=1 时额外记录空轮次心跳与回执统计(每几秒一行,默认关闭避免刷屏);
# 排障时再开。等价命令行 --verbose,--once 自检时自动开启。
# PRINT_AGENT_VERBOSE=1

# ============================================================================
# 打印通道(默认 tcp,一般不用改;macOS 15+ 打不出小票时看这里)
#
# macOS 15(Sequoia)起新增「本地网络」隐私权限:连接局域网需要授权,且授权按 App 识别。
# 由 launchd 自启动的代理属于被拦截的一类(在终端里手工跑 --probe 却能通,因为终端
# 及其子进程不受该限制),报错是:
#     dial tcp 192.168.x.x:9100: connect: no route to host
# 与「打印机没开机 / 网段不同」完全同形,极易误判。
#
# 绕开办法:让打印由系统打印服务(CUPS)发起 —— 本程序只把字节交给本机 cupsd,
# 而 cupsd 是由 launchd 启动的 root 守护进程,不受该权限限制。
#
# 用法:
#   1) 在「系统设置 → 打印机与扫描仪」以 IP 方式添加本店的网络打印机
#      (协议选 Socket / HP JetDirect / LPD),记下队列名(可用 `lpstat -v` 查看);
#   2) 设 PRINT_AGENT_PRINT_VIA=auto(推荐:仍优先直连,直连被拦时自动改投 CUPS)
#      或 =cups(一律走 CUPS);
#   3) 队列能自动发现(lpstat -v 里的 socket:// 设备),一般不必手填;填也支持:
#      PRINT_AGENT_CUPS_QUEUE=192.168.1.133=厨房打印机
#      多个用逗号分隔;只写队列名(如 =厨房打印机)则作为所有打印机的默认队列。
#
# 代价:CUPS 通道回读不到打印机 DLE EOT 实时状态(缺纸/盖板开只能靠出纸结果判断)。
# ============================================================================
# PRINT_AGENT_PRINT_VIA=auto
# PRINT_AGENT_CUPS_QUEUE=192.168.1.133=厨房打印机

# ============================================================================
# macOS 合盖继续运行(=1 时用 caffeinate 顶住空闲睡眠;默认关)
#
# 只设这一项**不足以**合盖继续打单,两件事都要做:
#   ① 关掉合盖睡眠(需管理员密码,一次性;caffeinate 挡不住 Clamshell Sleep):
#        sudo pmset -a disablesleep 1
#   ② 本项 =1(让 caffeinate 顶住空闲睡眠 —— 合盖后没有输入,空闲计时器会到点)
#
# 免 sudo 核对状态:
#   ioreg -r -c IOPMrootDomain -d 1 | grep SleepDisabled     # 期望 SleepDisabled = Yes
#
# 务必接交流电源:合盖运行持续耗电且发热。要恢复「合盖即睡」:
#   sudo pmset -a disablesleep 0
#
# 不填时 --install 会交互询问。Windows/Linux 忽略本项。
# ============================================================================
# PRINT_AGENT_NO_SLEEP=1
