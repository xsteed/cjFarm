/* 默认主页样式。
 * 页面可使用 app.wxss 的 token 与工具类（.card/.cny）；这里只补首页自己的版式。
 * 安全区：page 的 padding-bottom 与自身 padding 合并在同一条声明里（见 app.wxss 末尾注释）。
 */

.page {
  min-height: 100vh;
  padding-bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  background: var(--bg);
}

/* ---------- 品牌区 ---------- */

.hero {
  padding: 32rpx 28rpx 56rpx;
  background: var(--grad-brand);
  color: #fff;
}

/* min-width: 0 让超长店名能在头部正常省略，而不是把头部撑宽 */
.brand {
  min-width: 0;
}

.brand-name {
  overflow: hidden;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.brand-slogan {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgb(255 255 255 / 82%);
}

/* 扫码卡：整张卡都是点击区，右侧胶囊只是「这里可以点」的提示，不单独绑事件 */
.scan {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 32rpx;
  padding: 24rpx 24rpx 24rpx 26rpx;
  border-radius: var(--r-lg);
  background: #fff;
  box-shadow: 0 16rpx 40rpx rgb(160 40 0 / 24%);
}

/* 扫码框：浅底方块里画一个描边取景框 + 一条扫描线 */
.scan-ico {
  position: relative;
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: var(--brand-soft);
}

.scan-ico::before {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  left: 20rpx;
  border: 4rpx solid var(--brand-deep);
  border-radius: 6rpx;
  box-sizing: border-box;
  content: '';
}

.scan-ico::after {
  position: absolute;
  top: 36rpx;
  right: 16rpx;
  left: 16rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--brand-deep);
  content: '';
}

.scan-main {
  flex: 1;
  min-width: 0;
  color: var(--ink);
}

.scan-title {
  font-size: 32rpx;
  font-weight: 600;
}

.scan-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.scan-go {
  flex: none;
  padding: 14rpx 26rpx;
  border-radius: var(--r-pill);
  background: var(--grad-brand-soft);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgb(240 72 31 / 26%);
}

/* ---------- 主体：上移压住头部底边，与菜单页的白卡同一种衔接方式 ---------- */

.body {
  margin-top: -36rpx;
  padding: 0 24rpx;
}

/* 续用卡片（进行中的订单 / 上次的桌台） */
.entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx;
}

.entry-tag {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: var(--r-pill);
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 20rpx;
  line-height: 1.4;
}

/* 桌台不是「待办」而是信息，标签用中性色，避免和订单状态抢注意力 */
.entry-tag-plain {
  background: #f2f2f2;
  color: var(--ink-3);
}

.entry-main {
  flex: 1;
  min-width: 0;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.entry-sub {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--ink-3);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-go {
  flex: none;
  color: var(--brand-deep);
  font-size: 26rpx;
  font-weight: 600;
}

/* ---------- 招牌菜 ---------- */

.sec {
  margin-bottom: 20rpx;
  padding: 28rpx 24rpx;
}

.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.sec-sub {
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 横向滑动的招牌菜：一屏放三道左右，剩下的滑出来 */
.sig-scroll {
  width: 100%;
  white-space: nowrap;
}

.sig-row {
  display: inline-flex;
  gap: 20rpx;
}

.sig {
  flex: none;
  width: 200rpx;
}

.sig-media {
  position: relative;
  width: 200rpx;
  height: 150rpx;
  overflow: hidden;
  border-radius: var(--r-sm);
  background: #f2f2f2;
}

.sig-img {
  display: block;
  width: 200rpx;
  height: 150rpx;
}

.sig-img-none {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-4);
  font-size: 20rpx;
}

.sig-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgb(0 0 0 / 45%);
  color: #fff;
  font-size: 24rpx;
}

.sig-name {
  margin-top: 12rpx;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sig-price {
  margin-top: 4rpx;
  color: var(--brand-deep);
  font-size: 26rpx;
  font-weight: 700;
}

.sig-from {
  margin-left: 2rpx;
  color: var(--ink-3);
  font-size: 20rpx;
  font-weight: 400;
}

/* ---------- 点餐说明 ---------- */

.tips {
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx;
}

.tips-title {
  margin-bottom: 10rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 600;
}

.tip {
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.9;
}
