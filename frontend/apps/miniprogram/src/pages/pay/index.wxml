<view class="page">
  <view
    wx:if="{{loading}}"
    class="state"
  >
    <view class="spinner"></view>
    <view class="state-text">正在加载账单…</view>
  </view>

  <view
    wx:elif="{{error}}"
    class="state"
  >
    <view class="err-icon">!</view>
    <view class="state-text">{{error}}</view>
    <view class="btn-ghost" bindtap="onBack">返回订单</view>
  </view>

  <block wx:else>
    <scroll-view
      class="body"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
    >
      <!-- 金额 -->
      <view class="card amt">
        <view class="amt-label">本单应付</view>
        <view class="amt-value"><text class="cny">¥</text>{{totalText}}</view>
        <view class="amt-no" bindtap="onCopyOrderNo">
          单号 {{shortNo}} · {{statusText}}
        </view>
      </view>

      <block wx:if="{{paid}}">
        <!-- 付款成功卡：勾选描边动效，把全流程的情绪高点做出来 -->
        <view class="card paid">
          <view class="paid-check">
            <view class="paid-tick"></view>
          </view>
          <view class="paid-title">支付成功</view>
          <view class="paid-sub">后厨已经在做啦，出餐进度可在订单页查看</view>
        </view>
      </block>

      <block wx:else>
        <!-- 先付模式：下单后即进入本页，先说明「付完才开做」，再引导付款 -->
        <view
          wx:if="{{payFirst}}"
          class="card sec"
        >
          <view class="tip-line">💳 本店为先付模式：完成支付后后厨即刻开工～</view>
        </view>

        <!-- 渠道切换 -->
        <view class="card sec">
          <view class="tabs">
            <view
              class="tab {{payTab === 'wx' ? 'on' : ''}}"
              data-tab="wx"
              bindtap="onSwitchTab"
            >
              微信收款
            </view>
            <view
              class="tab {{payTab === 'ali' ? 'on' : ''}}"
              data-tab="ali"
              bindtap="onSwitchTab"
            >
              支付宝收款
            </view>
          </view>

          <view wx:if="{{hasQr}}" class="qr-wrap">
            <image
              class="qr-img"
              src="{{qrImage}}"
              mode="aspectFit"
              show-menu-by-longpress
            ></image>
            <view class="qr-tip">长按图片可保存到相册</view>
          </view>
          <view wx:else class="qr-empty">
            门店尚未配置该渠道的收款码，请到前台结账。
          </view>
        </view>

        <!-- 支付方式说明 -->
        <view class="card sec">
          <view class="sec-title">如何完成支付</view>
          <view class="tip-line">{{chanTip}}</view>
          <view class="tip-line">不用一直盯着，商家确认收款后本页会自动更新。</view>
        </view>

        <view class="bottom-pad"></view>
      </block>
    </scroll-view>

    <view class="foot">
      <view class="btn-ghost foot-minor" bindtap="onBack">返回订单</view>
      <!-- 后端开通 JSAPI 时给真正的在线支付入口；没开通仍是「手动查一次」的降级路径 -->
      <view
        wx:if="{{!paid && canWallet}}"
        class="btn-primary foot-main {{checking ? 'dim' : ''}}"
        bindtap="onPayWallet"
      >
        余额支付（¥{{walletBalanceText}}）
      </view>
      <view
        wx:if="{{!paid && !canWallet && walletShort}}"
        class="foot-wallet-tip"
      >
        储值余额 ¥{{walletBalanceText}}，不足以支付本单，可在「我的 → 储值余额」充值
      </view>
      <view
        wx:if="{{!paid && canJsapi}}"
        class="btn-primary foot-main {{checking ? 'dim' : ''}}"
        bindtap="onPayOnline"
      >
        {{checking ? '拉起支付…' : '微信支付'}}
      </view>
      <view
        wx:elif="{{!paid}}"
        class="btn-primary foot-main {{checking ? 'dim' : ''}}"
        bindtap="onCheck"
      >
        {{checking ? '查询中…' : '我已完成支付'}}
      </view>
    </view>
  </block>
</view>
