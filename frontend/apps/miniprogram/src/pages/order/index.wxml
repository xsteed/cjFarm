<view class="page">
  <view
    wx:if="{{loading}}"
    class="state"
  >
    <view class="spinner"></view>
    <view class="state-text">正在加载订单…</view>
  </view>

  <view
    wx:elif="{{error}}"
    class="state"
  >
    <view class="err-icon">!</view>
    <view class="state-text">{{error}}</view>
    <view class="state-actions">
      <!-- 网络类失败可以原地重试；「没有找到订单」这种再点多少次也没用，就不显示 -->
      <view
        wx:if="{{canRetry}}"
        class="btn-primary"
        bindtap="onRetry"
      >
        重试
      </view>
      <view
        class="btn-ghost"
        bindtap="onGoMenu"
      >
        去点菜
      </view>
    </view>
  </view>

  <block wx:else>
    <scroll-view
      class="body"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
    >
      <!-- 菜品明细：顾客最关心「点了什么、多少钱」，放第一张。
           订单状态与刷新收进卡头，桌台/单号/人数/时间统一挪到最后的「订单信息」卡。 -->
      <view class="card sec">
        <view class="sec-head">
          <view class="sec-title">菜品明细</view>
          <view class="sec-head-right">
            <view class="tag {{statusClass}}">{{statusText}}</view>
            <view class="sec-refresh" bindtap="onRefresh">刷新</view>
          </view>
        </view>

        <!-- 出餐进度：等餐的顾客最想知道「到哪一步了」。取消单没有进度可言，整块不渲染 -->
        <view
          wx:if="{{showProgress}}"
          class="steps"
        >
          <view
            wx:for="{{steps}}"
            wx:key="label"
            class="step {{item.on ? 'on' : ''}} {{item.now ? 'now' : ''}}"
          >
            <!-- 连接线：最后一步之后不再画（index 由 wx:for 提供） -->
            <view
              wx:if="{{index < 2}}"
              class="step-bar {{item.barOn ? 'on' : ''}}"
            ></view>
            <view class="step-dot"></view>
            <view class="step-txt">{{item.label}}</view>
          </view>
        </view>
        <view
          wx:for="{{rows}}"
          wx:key="key"
          class="row"
        >
          <view class="row-main">
            <view class="row-name">
              <text wx:if="{{item.batchLabel}}" class="row-batch">{{item.batchLabel}}</text>
              <text wx:if="{{item.isGift}}" class="row-gift">赠 </text>{{item.name}}<text wx:if="{{item.specName}}" class="row-spec">{{item.specName}}</text>
            </view>
            <view wx:if="{{item.itemRemark}}" class="row-remark">{{item.itemRemark}}</view>
          </view>
          <view class="row-qty">{{item.qtyText}}</view>
          <view class="row-amt {{item.isGift ? 'rowAmtGift' : ''}}">{{item.isGift ? '赠' : '¥' + item.amountText}}</view>
        </view>
        <view
          wx:if="{{orderRemark}}"
          class="order-remark"
        >
          订单备注：{{orderRemark}}
        </view>

        <!-- 账单明细：这几行加起来就是末行的「合计」，用来回答「为什么比点菜金额多」。
             合计与支付状态放在同一行，全页只出现一次。 -->
        <view class="bill">
          <view class="bill-row">
            <text>菜品小计</text>
            <text>¥{{dishTotalText}}</text>
          </view>
          <view
            wx:if="{{showSeatFee}}"
            class="bill-row"
          >
            <text>茶位费（{{personCount}}人）</text>
            <text>¥{{seatFeeText}}</text>
          </view>
          <view
            wx:if="{{showDiscount}}"
            class="bill-row bill-discount"
          >
            <text>满减优惠</text>
            <text>-¥{{discountText}}</text>
          </view>
          <view class="bill-row bill-total">
            <text>合计</text>
            <view class="bill-total-right">
              <view class="tag {{payClass}}">{{payText}}</view>
              <text class="bill-total-value"><text class="cny">¥</text>{{totalText}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 状态提示：只有「已取消 / 已完成 / 已结账」才出这张卡。
           进行中的单没有额外提示可说（进度在上面的菜品卡里），整卡不渲染 -->
      <view
        wx:if="{{canceled || done || settled}}"
        class="card sec"
      >
        <block wx:if="{{canceled}}">
          <view class="cancel-tip">{{cancelTip}}</view>
        </block>
        <block wx:else>
          <view wx:if="{{done}}" class="done-tip">🎉 这顿吃完啦，欢迎下次光临</view>
          <view wx:elif="{{settled}}" class="done-tip">已结账，后厨正在做啦～出餐进度会自动更新</view>
        </block>
      </view>

      <!-- 订单信息：桌台 / 单号 / 人数 / 时间。顾客核对单据时才看，不再挤在首屏 -->
      <view class="card sec">
        <view class="info-table">{{tableLabel}}</view>
        <view class="info-no">单号 {{shortNo}}</view>
        <view class="info-meta">
          <text>{{personCount}} 人用餐</text>
          <text wx:if="{{createTimeText}}">{{createTimeText}}</text>
        </view>
        <!-- 支付凭证：结账后留一条可核对的记录（渠道 + 时间） -->
        <view
          wx:if="{{paidInfo}}"
          class="info-paid"
        >
          <view class="info-paid-dot"></view>{{paidInfo}}
        </view>
      </view>

      <view class="bottom-pad"></view>
    </scroll-view>

    <!-- 底部动作栏（刷新收在菜品明细卡头，避免窄屏下四个按钮挤成一行放不下） -->
    <view class="foot">
      <view
        wx:if="{{canUrge}}"
        class="btn-ghost foot-minor {{urgeCooldown > 0 ? 'dim' : ''}}"
        bindtap="onUrge"
      >
        {{urgeCooldown > 0 ? urgeCooldown + 's 后可再催' : (urging ? '催菜中…' : '催菜')}}
      </view>
      <view
        wx:if="{{canAppend}}"
        class="btn-ghost foot-minor"
        bindtap="onAppend"
      >
        加菜
      </view>
      <view
        wx:if="{{canPay}}"
        class="btn-primary foot-main"
        bindtap="onPay"
      >
        去支付
      </view>
      <view
        wx:elif="{{settled || done || canceled}}"
        class="btn-primary foot-main"
        bindtap="onNewOrder"
      >
        再点一单
      </view>
    </view>
  </block>

  <!-- 常驻底部主导航：加载中 / 「本桌没有进行中订单」的空态下也能切回点餐 -->
  <tab-bar
    active="order"
    show-profile="{{showProfile}}"
  />
</view>
