<view class="page">
  <!-- 左上角返回：tab 切页（redirectTo，栈深 1）没有原生返回箭头，自己画一个；
       从菜单页「出餐中」标签 navigateTo 进来时原生箭头已在，showBack 为 false 不重复画 -->
  <view
    wx:if="{{showBack}}"
    class="page-back"
    bindtap="onBack"
  >
    <view class="pb-arrow"></view>
    <text class="pb-text">返回</text>
  </view>

  <view
    wx:if="{{loading}}"
    class="state"
  >
    <view class="spinner"></view>
    <view class="state-text">正在加载订单…</view>
  </view>

  <!-- 本桌有「已付款出餐中」的订单（session.currentOrder 不含它们）：
       先列出让顾客点一条看进度，而不是甩一句「没有找到进行中的订单」 -->
  <view
    wx:elif="{{showServingList}}"
    class="serving-pick"
  >
    <view class="sp-title">本桌正在出餐</view>
    <view
      wx:for="{{servingRows}}"
      wx:key="key"
      class="sp-item"
      data-no="{{item.orderNo}}"
      bindtap="onOpenServing"
    >
      <text class="sp-label">{{item.label}}</text>
      <text class="sp-go">查看订单 ›</text>
    </view>
    <view class="sp-hint">出餐中的订单已付款，无需再次支付</view>
    <view
      class="btn-ghost sp-menu"
      bindtap="onGoMenu"
    >
      去点菜
    </view>
  </view>

  <!-- 没有进行中的订单：与 H5 订单空态同一套内容与动画（见 OrderPage.vue 的 .order-empty）。
       插画 = 菜单卡 + 筷子 + 冒热气的茶杯，整体上下浮动、投影同步收放、星点闪烁、热气错拍升腾 -->
  <view
    wx:elif="{{noOrder}}"
    class="order-empty"
  >
    <view class="empty-illo">
      <view class="illo-shadow"></view>
      <view class="illo-spark s1"></view>
      <view class="illo-spark s2"></view>

      <!-- 单页菜单卡：品牌色标题栏 + 三行菜品占位 -->
      <view class="illo-card">
        <view class="illo-card-hd">
          <view class="illo-hd-dot"></view>
          <view class="illo-hd-line"></view>
        </view>
        <view class="illo-row r1"><view class="illo-dot"></view><view class="illo-line"></view></view>
        <view class="illo-row r2"><view class="illo-dot"></view><view class="illo-line short"></view></view>
        <view class="illo-row r3"><view class="illo-dot"></view><view class="illo-line mid"></view></view>
      </view>

      <!-- 托碟先画、杯子压在其上，形成「坐落」关系；杯口一点浅茶色交代杯内有水 -->
      <view class="illo-saucer"></view>
      <view class="illo-cup"></view>
      <view class="illo-tea"></view>

      <!-- 三缕热气：错拍升腾 -->
      <view class="illo-steam st1"></view>
      <view class="illo-steam st2"></view>
      <view class="illo-steam st3"></view>

      <!-- 筷子：前端浅橙 → 末端深橙，两根等长微倾 -->
      <view class="illo-chop c1"></view>
      <view class="illo-chop c2"></view>
    </view>
    <view class="empty-title">上桌啦，点起来吧</view>
    <view class="empty-sub">还没有进行中的订单，先去挑几道想吃的菜吧</view>
    <view
      class="empty-btn"
      bindtap="onGoMenu"
    >去点餐</view>
  </view>

  <view
    wx:elif="{{error}}"
    class="state"
  >
    <view class="err-icon">!</view>
    <view class="state-text">{{error}}</view>
    <view class="state-actions">
      <!-- 网络类失败可以原地重试；「没有找到订单」这种再点多少次也没用，就不显示 -->
      <view
        wx:if="{{canRetry}}"
        class="btn-primary"
        bindtap="onRetry"
      >
        重试
      </view>
      <view
        class="btn-ghost"
        bindtap="onGoMenu"
      >
        去点菜
      </view>
    </view>
  </view>

  <block wx:else>
    <scroll-view
      class="body"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
    >
      <!-- 菜品明细：顾客最关心「点了什么、多少钱」，放第一张。
           订单状态与刷新收进卡头，桌台/单号/人数/时间统一挪到最后的「订单信息」卡。 -->
      <view class="card sec">
        <view class="sec-head">
          <view class="sec-title">菜品明细</view>
          <view class="sec-head-right">
            <view class="tag {{statusClass}}">{{statusText}}</view>
            <view class="sec-refresh" bindtap="onRefresh">刷新</view>
          </view>
        </view>

        <!-- 出餐进度：等餐的顾客最想知道「到哪一步了」。取消单没有进度可言，整块不渲染 -->
        <view
          wx:if="{{showProgress}}"
          class="steps"
        >
          <view
            wx:for="{{steps}}"
            wx:key="label"
            class="step {{item.on ? 'on' : ''}} {{item.now ? 'now' : ''}}"
          >
            <!-- 连接线：最后一步之后不再画（index 由 wx:for 提供） -->
            <view
              wx:if="{{index < 2}}"
              class="step-bar {{item.barOn ? 'on' : ''}}"
            ></view>
            <view class="step-dot"></view>
            <view class="step-txt">{{item.label}}</view>
          </view>
        </view>
        <view
          wx:for="{{rows}}"
          wx:key="key"
          class="row"
        >
          <view class="row-main">
            <view class="row-name">
              <text wx:if="{{item.batchLabel}}" class="row-batch">{{item.batchLabel}}</text>
              <text wx:if="{{item.isGift}}" class="row-gift">赠 </text>{{item.name}}<text wx:if="{{item.specName}}" class="row-spec">{{item.specName}}</text>
            </view>
            <view wx:if="{{item.itemRemark}}" class="row-remark">{{item.itemRemark}}</view>
          </view>
          <view class="row-qty">{{item.qtyText}}</view>
          <view class="row-amt {{item.isGift ? 'rowAmtGift' : ''}}">{{item.isGift ? '赠' : '¥' + item.amountText}}</view>
        </view>
        <view
          wx:if="{{orderRemark}}"
          class="order-remark"
        >
          订单备注：{{orderRemark}}
        </view>

        <!-- 账单明细：这几行加起来就是末行的「合计」，用来回答「为什么比点菜金额多」。
             合计与支付状态放在同一行，全页只出现一次。 -->
        <view class="bill">
          <view class="bill-row">
            <text>菜品小计</text>
            <text>¥{{dishTotalText}}</text>
          </view>
          <view
            wx:if="{{showSeatFee}}"
            class="bill-row"
          >
            <text>茶位费（{{personCount}}人）</text>
            <text>¥{{seatFeeText}}</text>
          </view>
          <view
            wx:if="{{showDiscount}}"
            class="bill-row bill-discount"
          >
            <text>满减优惠</text>
            <text>-¥{{discountText}}</text>
          </view>
          <view class="bill-row bill-total">
            <text>合计</text>
            <view class="bill-total-right">
              <view class="tag {{payClass}}">{{payText}}</view>
              <text class="bill-total-value"><text class="cny">¥</text>{{totalText}}</text>
            </view>
          </view>
        </view>

        <!-- 待付款引导：点明「先付模式」与下一步动作，紧跟账单、与底部「去支付」按钮连成一条线。
             不带金额 —— 账单末行已给出，重复出现反而像两笔账 -->
        <view
          wx:if="{{showPayFirstTip}}"
          class="pay-first-tip"
        >
          💳 本店为先付模式：点击下方「去支付」完成付款，后厨即刻开工～
        </view>
      </view>

      <!-- 状态提示：只有「已取消 / 已完成 / 已结账」才出这张卡。
           进行中的单没有额外提示可说（进度在上面的菜品卡里），整卡不渲染 -->
      <view
        wx:if="{{canceled || done || settled}}"
        class="card sec"
      >
        <block wx:if="{{canceled}}">
          <view class="cancel-tip">{{cancelTip}}</view>
        </block>
        <block wx:else>
          <view wx:if="{{done}}" class="done-tip">🎉 这顿吃完啦，欢迎下次光临</view>
          <view wx:elif="{{settled}}" class="done-tip">已结账，后厨正在做啦～出餐进度会自动更新</view>
        </block>
      </view>

      <!-- 订单信息：桌台 / 单号 / 人数 / 时间。顾客核对单据时才看，不再挤在首屏 -->
      <view class="card sec">
        <view class="info-table">{{tableLabel}}</view>
        <view class="info-no">单号 {{shortNo}}</view>
        <view class="info-meta">
          <text>{{personCount}} 人用餐</text>
          <text wx:if="{{createTimeText}}">{{createTimeText}}</text>
          <!-- 改人数会重算茶位费：只在「进行中且未支付」时给入口（已支付改金额会对不上实收） -->
          <text
            wx:if="{{canEditPerson}}"
            class="info-edit"
            bindtap="onEditPerson"
          >{{updatingPerson ? '保存中…' : '修改'}}</text>
        </view>
        <!-- 支付凭证：结账后留一条可核对的记录（渠道 + 时间） -->
        <view
          wx:if="{{paidInfo}}"
          class="info-paid"
        >
          <view class="info-paid-dot"></view>{{paidInfo}}
        </view>
      </view>

      <view class="bottom-pad"></view>
    </scroll-view>

    <!-- 底部动作栏（刷新收在菜品明细卡头，避免窄屏下四个按钮挤成一行放不下） -->
    <view class="foot">
      <view
        wx:if="{{canUrge}}"
        class="btn-ghost foot-minor {{urgeCooldown > 0 ? 'dim' : ''}}"
        bindtap="onUrge"
      >
        {{urgeCooldown > 0 ? urgeCooldown + 's 后可再催' : (urging ? '催菜中…' : '催菜')}}
      </view>
      <view
        wx:if="{{canAppend}}"
        class="btn-ghost foot-minor"
        bindtap="onAppend"
      >
        加菜
      </view>
      <view
        wx:if="{{canPay}}"
        class="btn-primary foot-main"
        bindtap="onPay"
      >
        {{payBtnText}}
      </view>
      <view
        wx:elif="{{settled || done || canceled}}"
        class="btn-primary foot-main"
        bindtap="onNewOrder"
      >
        再点一单
      </view>
    </view>
  </block>

  <!-- 常驻底部主导航：加载中 / 「本桌没有进行中订单」的空态下也能切回点餐 -->
  <tab-bar
    active="order"
    show-profile="{{showProfile}}"
  />
</view>
