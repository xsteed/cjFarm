.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  /* 为常驻的底部导航留出空间（fixed 定位不参与布局）。
     留白由这一层统一让出，底部的 .foot 动作栏和安全区就不会被导航压住。 */
  padding-bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  background: var(--bg);
}

.state {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 0 60rpx;
}

.state-text {
  color: var(--ink-3);
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.spinner {
  width: 68rpx;
  height: 68rpx;
  border: 6rpx solid #ffe3d4;
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.err-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 60rpx;
  font-weight: 700;
  line-height: 104rpx;
  text-align: center;
}

/* 首张卡（菜品明细）与左右边距对齐：上下都是 24rpx，卡片不贴住顶部 */
.body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

/* ---------- 菜品明细卡头：标题 + 状态标签 + 手动刷新 ---------- */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

/* 标题占满剩余宽度：状态标签与刷新始终贴右，标题再长也不会把右侧挤出去 */
.sec-head .sec-title {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.sec-head-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 手动刷新：轮询每 3s 一次，这里只是「等不及」时的出口，做小、做轻 */
.sec-refresh {
  padding: 6rpx 4rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

/* ---------- 订单信息卡：桌台 / 单号 / 人数 / 时间（放菜品之后） ---------- */
.info-table {
  font-size: 30rpx;
  font-weight: 700;
}

.info-no {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  letter-spacing: 0.5rpx;
}

.info-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 23rpx;
}

/* 改人数入口：靠右的链接式按钮，不抢底部「去支付」的视觉重心 */
.info-edit {
  margin-left: auto;
  color: var(--brand-deep);
  font-weight: 600;
}

/* 支付凭证：绿点 + 「已支付（微信）· 2026-10-09 12:03」，可核对可回看 */
.info-paid {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  color: var(--success);
  font-size: 23rpx;
}

.info-paid-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--success);
}

/* ---------- 通用卡 ---------- */
.sec {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.sec-title {
  margin-bottom: 12rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

/* ---------- 完成 / 已取消 提示 ----------
   步骤条去掉后，提示就是这张卡里唯一的内容，不再需要上边距。 */
.done-tip,
.cancel-tip {
  padding: 18rpx 22rpx;
  border-radius: var(--r-md);
  background: var(--brand-ghost);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.cancel-tip {
  background: var(--danger-soft);
  color: var(--danger);
}

/* 先付模式提示（对应 H5 OrderTrackView 的 st-payfirst-tip）：
   紧贴账单末行，给底部「去支付」按钮做铺垫 */
.pay-first-tip {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--r-md);
  background: var(--brand-ghost);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---------- 出餐进度（对应 H5 OrderProgress.vue） ----------
   三步只映射后厨的真实节点，不承诺时间；当前节点用品牌光晕标出。 */
.steps {
  display: flex;
  align-items: flex-start;
  padding: 4rpx 0 20rpx;
}

.step {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

/* 连接线：从本步圆点拉到下一步圆点（flex:1 等宽保证两端对齐） */
.step-bar {
  position: absolute;
  top: 8rpx;
  left: 50%;
  width: 100%;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--line);
}

.step-bar.on {
  background: var(--brand);
}

.step-dot {
  position: relative;
  z-index: 1;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #e6e6e6;
  transition: background 0.25s;
}

.step.on .step-dot {
  background: var(--brand);
}

.step.now .step-dot {
  box-shadow: 0 0 0 8rpx var(--brand-soft);
}

.step-txt {
  color: var(--ink-4);
  font-size: 21rpx;
  line-height: 1.2;
}

.step.on .step-txt {
  color: var(--brand-deep);
  font-weight: 600;
}

/* ---------- 菜品行 ---------- */
.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid #f5f5f5;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-name {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

/* 多次加菜时的批次标：「首单」/「加菜N」，单批次订单不渲染（见 render 里的 multiBatch） */
.row-batch {
  display: inline-block;
  margin-right: 8rpx;
  padding: 0 8rpx;
  border-radius: var(--r-sm);
  background: #f2f2f2;
  color: var(--ink-3);
  font-size: 20rpx;
  line-height: 1.7;
}

/* 赠送菜标记：菜名前「赠」与金额位同色,与 H5 顾客端的让利色一致 */
.row-gift {
  color: #e8850c;
  font-weight: 700;
}

.rowAmtGift {
  color: #e8850c;
  font-weight: 700;
}

.row-spec {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--r-sm);
  background: #f4f4f4;
  color: var(--ink-3);
  font-size: 21rpx;
  font-weight: 400;
}

.row-remark {
  margin-top: 6rpx;
  color: var(--warning);
  font-size: 22rpx;
  line-height: 1.5;
}

.row-qty {
  flex-shrink: 0;
  color: var(--ink-3);
  font-size: 25rpx;
}

.row-amt {
  flex-shrink: 0;
  min-width: 120rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
}

.order-remark {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed var(--line);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

/* 账单明细：这几行加起来就是末行的「合计」，用来回答「为什么比点菜金额多」 */
.bill {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed var(--line);
}

.bill-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 0;
  color: var(--ink-3);
  font-size: 25rpx;
}

.bill-discount {
  color: var(--warning);
}

/* 合计行：账单收尾，金额与「未支付 / 已支付」标签同排。
   虚线上下的留白对齐（上一行 6rpx 下内边距 + 18rpx 外边距 = 24rpx，下方 24rpx） */
.bill-total {
  margin-top: 18rpx;
  padding: 24rpx 0 0;
  border-top: 2rpx dashed var(--line);
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

/* 窄屏兜底：标签文案较长（如「挂账待收 ¥12.00」）时也不把金额挤变形 */
.bill-total-right {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 16rpx;
}

.bill-total-value {
  color: var(--brand-deep);
  font-size: 36rpx;
  font-weight: 700;
}

/* ---------- 底部动作栏 ---------- */
.foot {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  /* 不用再让安全区：底部安全区与导航的高度已由 .page 的 padding-bottom 统一让出，
     这里再加一次会多出一条空白。 */
  padding-bottom: 18rpx;
  border-top: 2rpx solid var(--line);
  background: #fff;
}

.foot-minor {
  flex-shrink: 0;
  height: 76rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

.foot-minor.dim {
  color: var(--ink-4);
}

.foot-main {
  flex: 1;
  height: 84rpx;
  padding: 0;
  font-size: 30rpx;
}

.bottom-pad {
  height: 40rpx;
}

/* 错误态的动作按钮（重试 / 去点菜） */
.state-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

/* ---------- 「出餐中订单」列表：已付款出餐中的单在这里点开看进度 ---------- */
.serving-pick {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
}

.sp-title {
  margin-bottom: 24rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
}

.sp-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: var(--r-lg);
  background: #fff;
  box-shadow: var(--shadow-1);
}

.sp-label {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.sp-go {
  flex-shrink: 0;
  color: var(--brand-deep);
  font-size: 24rpx;
}

.sp-hint {
  margin-bottom: 32rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

/* 「去点菜」压到列表底部：想继续点的人一眼能看到入口 */
.sp-menu {
  margin-top: auto;
}
