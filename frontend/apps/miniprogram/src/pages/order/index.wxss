.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  /* 为常驻的底部导航留出空间（fixed 定位不参与布局）。
     留白由这一层统一让出，底部的 .foot 动作栏和安全区就不会被导航压住。 */
  padding-bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  background: var(--bg);
}

/* 左上角返回：tab 切页没有原生返回箭头时自绘（栈里有上一层就交给原生箭头） */
.page-back {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  padding: 20rpx 32rpx 0;
  color: var(--ink-2);
  font-size: 26rpx;
}

/* 「返回」文案：与箭头同一行，字号/颜色跟随导航条（此前缺这条定义，
 * WXSS 审计会报「class 未定义」而挡住 npm run mp:verify）。 */
.pb-text {
  font-size: 26rpx;
  color: var(--ink-2);
}

/* 左向箭头：CSS 边框旋转 45°，与加减号同一套几何画法 */
.pb-arrow {
  width: 13rpx;
  height: 13rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.state {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 0 60rpx;
}

.state-text {
  color: var(--ink-3);
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.spinner {
  width: 68rpx;
  height: 68rpx;
  border: 6rpx solid #ffe3d4;
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.err-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 60rpx;
  font-weight: 700;
  line-height: 104rpx;
  text-align: center;
}

/* ---------- 订单空态：与 H5 OrderPage.vue 的 .order-empty 一致 ----------
   插画原型是 H5 里那段 SVG（viewBox 120×96），这里按 208rpx × 168rpx 等比换算成纯 CSS：
   整体上下浮动、桌面投影同步收放、星点轮流闪烁、三缕热气错拍升腾。
   改任何坐标/时长前先对照 H5，两边构图与节奏必须保持一致（见 docs/miniprogram.md 第七节）。
   H5 用 prefers-reduced-motion 收掉动画，WXSS 没有对应能力，故此处不做降级。 */
.order-empty {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx 80rpx;
  text-align: center;
}

.empty-illo {
  position: relative;
  width: 208rpx;
  height: 168rpx;
  animation: empty-float 2.4s ease-in-out infinite;
}

/* 桌面投影：整图浮动时影子同步收放，保持「落地」错觉 */
.illo-shadow {
  position: absolute;
  bottom: 4rpx;
  left: 24rpx;
  width: 160rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ffb27d;
  animation: shadow-breathe 2.4s ease-in-out infinite;
}

/* 星点：H5 是 SVG 的 ✦ 路径（四角尖、腰内凹），这里用 clip-path 八点多边形精确复刻。
   别用「双椭圆正交」拼：横瓣一旦忘了垂直居中就渲染成蘑菇，而且椭圆相交只能是
   「加号」轮廓，拼不出 ✦ 的内凹腰。clip-path 属于样式基线（iOS 14.5+）能力，真机可用。
   多边形取值即 H5 路径的归一化坐标（腰位 33.3% / 66.7%），颜色刻意不走 token。 */
.illo-spark {
  position: absolute;
  width: 27rpx;
  height: 27rpx;
  background: #ffb27d;
  clip-path: polygon(
    50% 0%,
    66.7% 33.3%,
    100% 50%,
    66.7% 66.7%,
    50% 100%,
    33.3% 66.7%,
    0% 50%,
    33.3% 33.3%
  );
  animation: spark-twinkle 1.8s ease-in-out infinite;
}

.illo-spark.s1 {
  top: 24rpx;
  left: 11rpx;
}

/* 小的那枚偏高、偏右，且比大星点瘦长（比例同 H5 路径），与大星点错开 */
.illo-spark.s2 {
  top: 17rpx;
  left: 129rpx;
  width: 19rpx;
  height: 27rpx;
  animation-delay: 0.9s;
}

/* 单页菜单卡：白底 + 品牌色描边，标题栏压在三行菜品占位上方 */
.illo-card {
  position: absolute;
  top: 38rpx;
  left: 42rpx;
  width: 97rpx;
  height: 83rpx;
  border: 7rpx solid var(--brand);
  border-radius: 9rpx;
  box-sizing: border-box;
  background: #fff;
}

.illo-card-hd {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 21rpx;
  padding: 0 6rpx;
  border-radius: 3rpx 3rpx 0 0;
  background: var(--brand);
}

.illo-hd-dot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #fff;
}

.illo-hd-line {
  width: 44rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #fff;
}

/* 三行菜品占位：橙点 + 灰色短线（长度对应 H5 的三行，第二行最短） */
.illo-row {
  position: absolute;
  left: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 10rpx;
}

.illo-row.r1 {
  top: 25rpx;
}

.illo-row.r2 {
  top: 42rpx;
}

.illo-row.r3 {
  top: 59rpx;
}

.illo-dot {
  flex: none;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ffb27d;
}

.illo-line {
  width: 38rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: var(--ink-4);
}

.illo-line.short {
  width: 28rpx;
}

.illo-line.mid {
  width: 35rpx;
}

/* 托碟：宽浅椭圆，先画让杯子压在其上 */
.illo-saucer {
  position: absolute;
  top: 104rpx;
  left: 146rpx;
  width: 56rpx;
  height: 14rpx;
  border: 5rpx solid var(--brand);
  border-radius: 50%;
  box-sizing: border-box;
  background: #fff;
}

/* 茶杯：上开口的白瓷杯（无上边框），杯口一点浅茶色 */
.illo-cup {
  position: absolute;
  top: 82rpx;
  left: 159rpx;
  width: 30rpx;
  height: 28rpx;
  border: 6rpx solid var(--brand);
  border-top: none;
  border-radius: 0 0 10rpx 10rpx;
  box-sizing: border-box;
  background: #fff;
}

.illo-tea {
  position: absolute;
  top: 79rpx;
  left: 163rpx;
  width: 21rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #f7c9a8;
}

/* 三缕热气：每缕是上下两段弧首尾相接的 S 形（对应 H5 那段 `c` 曲线路径），
   不是一根直棍。上段左凸、下段右凸，两端落在同一竖线上。
   用「单边 border + 大圆角」画弧：只设 border-left 时，左边会连成一条光滑的「(」。 */
.illo-steam {
  position: absolute;
  top: 62rpx;
  width: 12rpx;
  height: 16rpx;
  animation: steam-rise 2.2s ease-in-out infinite;
}

.illo-steam::before {
  /* 上段：左凸弧 */
  position: absolute;
  top: 0;
  left: 0;
  width: 12rpx;
  height: 8rpx;
  border-left: 4rpx solid #ffb27d;
  border-radius: 30%;
  box-sizing: border-box;
  content: '';
}

.illo-steam::after {
  /* 下段：右凸弧，左移 5rpx 与上段首尾相接 */
  position: absolute;
  top: 8rpx;
  left: -5rpx;
  width: 12rpx;
  height: 8rpx;
  border-right: 4rpx solid #ffb27d;
  border-radius: 30%;
  box-sizing: border-box;
  content: '';
}

.illo-steam.st1 {
  left: 163rpx;
}

.illo-steam.st2 {
  left: 172rpx;
  animation-delay: 0.7s;
}

.illo-steam.st3 {
  left: 180rpx;
  animation-delay: 1.4s;
}

/* 筷子：整根单段 + 渐变着色（前端浅、末端深，无接缝），微倾压在菜单卡前 */
.illo-chop {
  position: absolute;
  width: 87rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(to right, #ff9c66 0%, var(--brand-deep) 100%);
  transform-origin: left center;
}

.illo-chop.c1 {
  top: 136rpx;
  left: 35rpx;
  transform: rotate(-4.6deg);
}

.illo-chop.c2 {
  top: 144rpx;
  left: 38rpx;
  transform: rotate(-4.6deg);
}

.empty-title {
  margin-top: 32rpx;
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 700;
}

.empty-sub {
  max-width: 520rpx;
  margin-top: 16rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  line-height: 1.6;
}

.empty-btn {
  margin-top: 48rpx;
  padding: 22rpx 72rpx;
  border-radius: var(--r-pill);
  background: var(--grad-brand-soft);
  box-shadow: 0 8rpx 18rpx rgb(240 72 31 / 28%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

@keyframes empty-float {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-16rpx);
  }
}

/* 桌面投影：整图浮动时影子同步收放，保持「落地」错觉 */
@keyframes shadow-breathe {
  0%,
  100% {
    opacity: 0.38;
    transform: scaleX(1);
  }

  50% {
    opacity: 0.2;
    transform: scaleX(0.88);
  }
}

/* 星点轮流闪烁：四角星本身已轴对齐，缩放不再需要带旋转 */
@keyframes spark-twinkle {
  0%,
  100% {
    opacity: 0.35;
    transform: scale(0.8);
  }

  50% {
    opacity: 1;
    transform: scale(1.15);
  }
}

@keyframes steam-rise {
  0%,
  100% {
    opacity: 0.3;
    transform: translateY(2rpx);
  }

  50% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
}

/* 首张卡（菜品明细）与左右边距对齐：上下都是 24rpx，卡片不贴住顶部 */
.body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

/* ---------- 菜品明细卡头：标题 + 状态标签 + 手动刷新 ---------- */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

/* 标题占满剩余宽度：状态标签与刷新始终贴右，标题再长也不会把右侧挤出去 */
.sec-head .sec-title {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.sec-head-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 手动刷新：轮询每 3s 一次，这里只是「等不及」时的出口，做小、做轻 */
.sec-refresh {
  padding: 6rpx 4rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

/* ---------- 订单信息卡：桌台 / 单号 / 人数 / 时间（放菜品之后） ---------- */
.info-table {
  font-size: 30rpx;
  font-weight: 700;
}

.info-no {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  letter-spacing: 0.5rpx;
}

.info-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 23rpx;
}

/* 改人数入口：靠右的链接式按钮，不抢底部「去支付」的视觉重心 */
.info-edit {
  margin-left: auto;
  color: var(--brand-deep);
  font-weight: 600;
}

/* 支付凭证：绿点 + 「已支付（微信）· 2026-10-09 12:03」，可核对可回看 */
.info-paid {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  color: var(--success);
  font-size: 23rpx;
}

.info-paid-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--success);
}

/* ---------- 通用卡 ---------- */
.sec {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.sec-title {
  margin-bottom: 12rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

/* ---------- 完成 / 已取消 提示 ----------
   步骤条去掉后，提示就是这张卡里唯一的内容，不再需要上边距。 */
.done-tip,
.cancel-tip {
  padding: 18rpx 22rpx;
  border-radius: var(--r-md);
  background: var(--brand-ghost);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.cancel-tip {
  background: var(--danger-soft);
  color: var(--danger);
}

/* 催菜：底部按钮下方的一句小字，不是按钮（对应 H5 .st-urge-line）。
   它是「等太久」才用一次的兜底动作，做成按钮、或压在按钮上面，都会跟
   「加菜 / 去支付」抢视线；只有「催一下后厨」可点，靠一条细下划线示意 */
.urge-line {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.6;
}

.urge-link {
  color: var(--ink-3);
  font-weight: 500;
  text-decoration: underline;
}

/* 先付模式提示（对应 H5 OrderTrackView 的 st-payfirst-tip）：
   紧贴账单末行，给底部「去支付」按钮做铺垫 */
.pay-first-tip {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--r-md);
  background: var(--brand-ghost);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---------- 出餐进度（对应 H5 OrderProgress.vue） ----------
   三步只映射后厨的真实节点，不承诺时间；当前节点用品牌光晕标出。 */
.steps {
  display: flex;
  align-items: flex-start;
  padding: 4rpx 0 20rpx;
}

.step {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

/* 连接线：从本步圆点拉到下一步圆点（flex:1 等宽保证两端对齐） */
.step-bar {
  position: absolute;
  top: 8rpx;
  left: 50%;
  width: 100%;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--line);
}

.step-bar.on {
  background: var(--brand);
}

.step-dot {
  position: relative;
  z-index: 1;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #e6e6e6;
  transition: background 0.25s;
}

.step.on .step-dot {
  background: var(--brand);
}

.step.now .step-dot {
  box-shadow: 0 0 0 8rpx var(--brand-soft);
}

.step-txt {
  color: var(--ink-4);
  font-size: 21rpx;
  line-height: 1.2;
}

.step.on .step-txt {
  color: var(--brand-deep);
  font-weight: 600;
}

/* ---------- 菜品行 ---------- */
.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid #f5f5f5;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-name {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

/* 多次加菜时的批次标：「首单」/「加菜N」，单批次订单不渲染（见 render 里的 multiBatch） */
.row-batch {
  display: inline-block;
  margin-right: 8rpx;
  padding: 0 8rpx;
  border-radius: var(--r-sm);
  background: #f2f2f2;
  color: var(--ink-3);
  font-size: 20rpx;
  line-height: 1.7;
}

/* 赠送菜标记：菜名前「赠」与金额位同色,与 H5 顾客端的让利色一致 */
.row-gift {
  color: #e8850c;
  font-weight: 700;
}

.rowAmtGift {
  color: #e8850c;
  font-weight: 700;
}

.row-spec {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--r-sm);
  background: #f4f4f4;
  color: var(--ink-3);
  font-size: 21rpx;
  font-weight: 400;
}

.row-remark {
  margin-top: 6rpx;
  color: var(--warning);
  font-size: 22rpx;
  line-height: 1.5;
}

.row-qty {
  flex-shrink: 0;
  color: var(--ink-3);
  font-size: 25rpx;
}

.row-amt {
  flex-shrink: 0;
  min-width: 120rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
}

.order-remark {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed var(--line);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

/* 账单明细：这几行加起来就是末行的「合计」，用来回答「为什么比点菜金额多」 */
.bill {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed var(--line);
}

.bill-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 0;
  color: var(--ink-3);
  font-size: 25rpx;
}

.bill-discount {
  color: var(--warning);
}

/* 合计行：账单收尾，金额与「未支付 / 已支付」标签同排。
   虚线上下的留白对齐（上一行 6rpx 下内边距 + 18rpx 外边距 = 24rpx，下方 24rpx） */
.bill-total {
  margin-top: 18rpx;
  padding: 24rpx 0 0;
  border-top: 2rpx dashed var(--line);
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

/* 窄屏兜底：标签文案较长（如「挂账待收 ¥12.00」）时也不把金额挤变形 */
.bill-total-right {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 16rpx;
}

.bill-total-value {
  color: var(--brand-deep);
  font-size: 36rpx;
  font-weight: 700;
}

/* ---------- 底部动作栏 ---------- */
.foot {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  padding: 18rpx 24rpx;
  /* 不用再让安全区：底部安全区与导航的高度已由 .page 的 padding-bottom 统一让出，
     这里再加一次会多出一条空白。 */
  padding-bottom: 18rpx;
  border-top: 2rpx solid var(--line);
  background: #fff;
}

/* 按钮行：动作并排一行，催菜那行小字排在它下面（不进这一行） */
.foot-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.foot-minor {
  flex-shrink: 0;
  height: 76rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

.foot-minor.dim {
  color: var(--ink-4);
}

.foot-main {
  flex: 1;
  height: 84rpx;
  padding: 0;
  font-size: 30rpx;
}

.bottom-pad {
  height: 40rpx;
}

/* 错误态的动作按钮（重试 / 去点菜） */
.state-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

/* ---------- 「出餐中订单」列表：已付款出餐中的单在这里点开看进度 ---------- */
.serving-pick {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
}

.sp-title {
  margin-bottom: 24rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
}

.sp-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: var(--r-lg);
  background: #fff;
  box-shadow: var(--shadow-1);
}

.sp-label {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.sp-go {
  flex-shrink: 0;
  color: var(--brand-deep);
  font-size: 24rpx;
}

.sp-hint {
  margin-bottom: 32rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

/* 「去点菜」压到列表底部：想继续点的人一眼能看到入口 */
.sp-menu {
  margin-top: auto;
}

