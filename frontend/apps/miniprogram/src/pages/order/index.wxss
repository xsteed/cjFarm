.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  /* 为常驻的底部导航留出空间（fixed 定位不参与布局）。
     留白由这一层统一让出，底部的 .foot 动作栏和安全区就不会被导航压住。 */
  padding-bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  background: var(--bg);
}

.state {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 0 60rpx;
}

.state-text {
  color: var(--ink-3);
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.spinner {
  width: 68rpx;
  height: 68rpx;
  border: 6rpx solid #ffe3d4;
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.err-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 60rpx;
  font-weight: 700;
  line-height: 104rpx;
  text-align: center;
}

.body {
  flex: 1;
  min-height: 0;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}

/* ---------- 菜品明细卡头：标题 + 状态标签 + 手动刷新 ---------- */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.sec-head .sec-title {
  margin-bottom: 0;
}

.sec-head-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 手动刷新：轮询每 3s 一次，这里只是「等不及」时的出口，做小、做轻 */
.head-refresh {
  padding: 6rpx 4rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

/* ---------- 订单信息卡：桌台 / 单号 / 人数 / 时间（放菜品之后） ---------- */
.info-table {
  font-size: 30rpx;
  font-weight: 700;
}

.info-no {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  letter-spacing: 0.5rpx;
}

.info-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 23rpx;
}

/* ---------- 通用卡 ---------- */
.sec {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.sec-title {
  margin-bottom: 12rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

/* ---------- 完成 / 已取消 提示 ----------
   步骤条去掉后，提示就是这张卡里唯一的内容，不再需要上边距。 */
.done-tip,
.cancel-tip {
  padding: 18rpx 22rpx;
  border-radius: var(--r-md);
  background: var(--brand-ghost);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.cancel-tip {
  background: var(--danger-soft);
  color: var(--danger);
}

/* ---------- 菜品行 ---------- */
.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid #f5f5f5;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-name {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

/* 多次加菜时的批次标：「首单」/「加菜N」，单批次订单不渲染（见 render 里的 multiBatch） */
.row-batch {
  display: inline-block;
  margin-right: 8rpx;
  padding: 0 8rpx;
  border-radius: var(--r-sm);
  background: #f2f2f2;
  color: var(--ink-3);
  font-size: 20rpx;
  line-height: 1.7;
}

/* 赠送菜标记：菜名前「赠」与金额位同色,与 H5 顾客端的让利色一致 */
.row-gift {
  color: #e8850c;
  font-weight: 700;
}

.rowAmtGift {
  color: #e8850c;
  font-weight: 700;
}

.row-spec {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--r-sm);
  background: #f4f4f4;
  color: var(--ink-3);
  font-size: 21rpx;
  font-weight: 400;
}

.row-remark {
  margin-top: 6rpx;
  color: var(--warning);
  font-size: 22rpx;
  line-height: 1.5;
}

.row-qty {
  flex-shrink: 0;
  color: var(--ink-3);
  font-size: 25rpx;
}

.row-amt {
  flex-shrink: 0;
  min-width: 120rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
}

.order-remark {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed var(--line);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

/* 账单明细：这几行加起来就是末行的「合计」，用来回答「为什么比点菜金额多」 */
.bill {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed var(--line);
}

.bill-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 0;
  color: var(--ink-3);
  font-size: 25rpx;
}

.bill-discount {
  color: var(--warning);
}

/* 合计行：账单收尾，金额与「未支付 / 已支付」标签同排 */
.bill-total {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--line);
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.bill-total-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bill-total-value {
  color: var(--brand-deep);
  font-size: 36rpx;
  font-weight: 700;
}

/* ---------- 底部动作栏 ---------- */
.foot {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  /* 不用再让安全区：底部安全区与导航的高度已由 .page 的 padding-bottom 统一让出，
     这里再加一次会多出一条空白。 */
  padding-bottom: 18rpx;
  border-top: 2rpx solid var(--line);
  background: #fff;
}

.foot-minor {
  flex-shrink: 0;
  height: 76rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

.foot-minor.dim {
  color: var(--ink-4);
}

.foot-main {
  flex: 1;
  height: 84rpx;
  padding: 0;
  font-size: 30rpx;
}

.bottom-pad {
  height: 40rpx;
}

/* 错误态的动作按钮（重试 / 去点菜） */
.state-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}
