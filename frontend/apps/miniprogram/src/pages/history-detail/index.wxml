<!-- 历史订单详情：只读 + 「再来一单」。不轮询、不加菜、不催菜（那是订单页的事）。 -->
<view class="page">
  <view
    wx:if="{{loading}}"
    class="state"
  >
    <view class="spinner"></view>
    <view class="state-text">加载中…</view>
  </view>

  <view
    wx:elif="{{error}}"
    class="state"
  >
    <view class="state-text">{{error}}</view>
    <view
      class="btn-ghost"
      bindtap="onRetry"
    >
      重新加载
    </view>
  </view>

  <block wx:else>
    <scroll-view
      scroll-y
      class="body"
    >
      <!-- 订单信息：桌台 / 状态 / 单号 / 时间 / 人数 / 支付状态 -->
      <view class="card sec">
        <view class="head">
          <view class="head-table">{{tableLabel}}</view>
          <view class="tag {{statusClass}}">{{statusText}}</view>
        </view>
        <view class="head-meta">
          <text>单号 {{shortNo}}</text>
          <text wx:if="{{createTimeText}}">{{createTimeText}}</text>
        </view>
        <view class="head-meta">
          <text>{{personCount}} 人用餐</text>
          <view class="tag {{payClass}}">{{payText}}</view>
        </view>
      </view>

      <!-- 菜品明细 -->
      <view class="card sec">
        <view class="sec-title">菜品明细</view>
        <view
          wx:if="{{!rows.length}}"
          class="empty"
        >
          这单没有菜品明细
        </view>
        <view
          wx:for="{{rows}}"
          wx:key="key"
          class="row"
        >
          <view class="row-main">
            <view class="row-name">
              <text
                wx:if="{{item.isGift}}"
                class="row-gift"
              >赠 </text>{{item.name}}<text
                wx:if="{{item.specName}}"
                class="row-spec"
              >{{item.specName}}</text>
            </view>
            <view
              wx:if="{{item.itemRemark}}"
              class="row-remark"
            >备注：{{item.itemRemark}}</view>
          </view>
          <view class="row-qty">{{item.qtyText}}</view>
          <view class="row-amt">{{item.amountText}}</view>
        </view>
        <view
          wx:if="{{orderRemark}}"
          class="order-remark"
        >整单备注：{{orderRemark}}</view>
      </view>

      <!-- 账单 -->
      <view class="card sec">
        <view class="bill-row">
          <text>菜品小计</text>
          <text>¥{{dishTotalText}}</text>
        </view>
        <view
          wx:if="{{showSeatFee}}"
          class="bill-row"
        >
          <text>茶位费（{{personCount}}人）</text>
          <text>¥{{seatFeeText}}</text>
        </view>
        <view
          wx:if="{{showDiscount}}"
          class="bill-row"
        >
          <text>优惠</text>
          <text>-¥{{discountText}}</text>
        </view>
        <view class="bill-row bill-total">
          <text>合计</text>
          <text class="bill-total-value">¥{{totalText}}</text>
        </view>
      </view>

      <view class="bottom-pad"></view>
    </scroll-view>

    <view class="foot">
      <!-- 只有「当前桌台 + 未支付 + 进行中」才给去支付（见 render 的 canPay） -->
      <view
        wx:if="{{canPay}}"
        class="btn-ghost foot-minor"
        bindtap="onPay"
      >
        去支付
      </view>
      <view
        wx:if="{{canReorder}}"
        class="btn-primary foot-main {{reordering ? 'dim' : ''}}"
        bindtap="onReorder"
      >
        {{reordering ? '处理中…' : '再来一单'}}
      </view>
      <view
        wx:else
        class="btn-primary foot-main dim"
      >
        没有可复制的菜品
      </view>
    </view>
  </block>
</view>
