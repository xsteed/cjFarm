<!-- 我的：会员卡 + 储值余额 + 历史订单。登录自愿，未登录也渲染登录后的完整结构，
     只是会员卡显示头像占位与登录/注册引导（点卡即登录），订单/余额区为引导态。 -->
<view class="page">
  <view
    wx:if="{{loading && !member}}"
    class="state"
  >
    <view class="spinner"></view> 加载中…
  </view>

  <view
    wx:elif="{{error}}"
    class="state"
  >
    <view class="state-err">{{error}}</view>
    <button
      class="btn-ghost"
      bindtap="onRetry"
    >
      重新加载
    </button>
  </view>

  <block wx:else>
    <!-- 会员卡：登录与否都渲染同一结构；未登录时头像位是占位、整卡可点进登录 -->
    <view
      class="card {{loggedIn ? 'cardOn' : 'cardOff'}}"
      bindtap="onCardTap"
    >
      <block wx:if="{{loggedIn && member}}">
        <view class="card-avatar">{{avatarChar}}</view>
        <view class="card-main">
          <!-- 昵称与「改名」同一行：昵称可能很长，给它单独留能收缩的空间 -->
          <view class="name-row">
            <view class="card-name ellipsis">{{member.nickname}}</view>
            <view
              class="edit-name"
              catchtap="onEditNickname"
            >
              改名
            </view>
          </view>
          <view class="card-sub">入会 {{member.memberSince}}</view>
        </view>
        <view class="card-stat">
          <view class="stat-num">{{member.orderCount}}</view>
          <view class="stat-label">累计订单</view>
        </view>
      </block>
      <block wx:else>
        <view class="card-avatar card-avatar-off">会</view>
        <view class="card-main">
          <view class="card-name">{{enabled ? '未登录' : '会员功能未开启'}}</view>
          <view class="card-sub">{{enabled ? '点击登录 / 注册，随时查看历史订单' : '请联系商家在系统配置中开启'}}</view>
        </view>
        <view
          wx:if="{{enabled}}"
          class="card-arrow"
        >›</view>
      </block>
    </view>

    <button
      wx:if="{{enabled && !loggedIn}}"
      class="btn-primary"
      disabled="{{pending}}"
      bindtap="onLogin"
    >
      {{pending ? '登录中…' : '微信一键注册成为会员'}}
    </button>
    <!-- 注册前的告知：《个人信息保护法》要求处理个人信息前明示并取得同意。
         两处协议必须是**可点击**的，只给一行灰字不算「提供查阅方式」。 -->
    <view
      wx:if="{{enabled && !loggedIn}}"
      class="agree-line"
    >
      登录即表示已阅读并同意<text
        class="agree-link"
        bindtap="onOpenTerms"
      >《用户服务协议》</text>与<text
        class="agree-link"
        bindtap="onOpenPrivacy"
      >《隐私政策》</text>
    </view>
    <view
      wx:if="{{loggedIn}}"
      class="actions-row"
    >
      <button
        wx:if="{{!phone}}"
        class="btn-ghost btn-half"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
      >
        绑定手机号
      </button>
      <button
        class="btn-ghost btn-half"
        bindtap="onLogout"
      >
        退出登录
      </button>
    </view>

    <!-- 储值余额：登录与否都渲染（未登录为引导态）；整行可点，
         已登录进钱包页（充值/流水），未登录触发登录 -->
    <view
      wx:if="{{enabled}}"
      class="wallet-row"
      bindtap="onOpenWallet"
    >
      <view class="wallet-label">储值余额</view>
      <view class="wallet-amount">{{loggedIn ? '¥' + balanceText : '—'}}</view>
      <view
        wx:if="{{loggedIn && canRecharge}}"
        class="wallet-action"
      >
        去充值 ›
      </view>
      <view
        wx:elif="{{!loggedIn}}"
        class="wallet-action"
      >
        登录后查看 ›
      </view>
    </view>

    <!-- 历史订单：未登录也显示区块，用引导文案代替空态 -->
    <view
      wx:if="{{enabled}}"
      class="sec"
    >
      <view class="sec-head">
        <view class="sec-title">我的订单</view>
        <view
          wx:if="{{loggedIn}}"
          class="sec-sub"
        >共 {{total}} 单</view>
      </view>

      <view
        wx:if="{{orders.length === 0}}"
        class="empty"
      >
        {{loggedIn ? '还没有订单，去点一单吧' : '登录后可查看历史订单'}}
      </view>

      <view
        wx:for="{{orders}}"
        wx:key="orderNo"
        class="order"
        data-no="{{item.orderNo}}"
        bindtap="onOpenOrder"
      >
        <view class="order-top">
          <view class="order-table">{{item.tableName}}</view>
          <view class="tag {{item.statusClass}}">{{item.statusText}}</view>
        </view>
        <view class="order-mid">
          <view class="order-no">{{item.orderNo}}</view>
          <view
            wx:if="{{item.pickupText}}"
            class="order-pickup"
          >
            {{item.pickupText}}
          </view>
        </view>
        <view class="order-bot">
          <view class="order-time">{{item.timeText}}</view>
          <view class="order-right">
            <view class="order-amt">¥{{item.amountText}}</view>
            <!-- 箭头暗示可点：点进去是只读详情 + 「再来一单」 -->
            <view class="order-arrow">›</view>
          </view>
        </view>
      </view>

      <button
        wx:if="{{loggedIn && hasMore}}"
        class="btn-ghost btn-more"
        disabled="{{loadingMore}}"
        bindtap="onLoadMore"
      >
        {{loadingMore ? '加载中…' : '加载更多'}}
      </button>
    </view>

    <!-- 注销入口放最底部：不可撤销，不该和常用操作挨在一起 -->
    <view
      wx:if="{{loggedIn}}"
      class="danger-zone"
      bindtap="onDeleteAccount"
    >
      注销会员
    </view>
  </block>

  <tab-bar
    active="profile"
    show-profile="{{enabled}}"
  />
</view>
