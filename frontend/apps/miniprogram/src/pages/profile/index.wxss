/* 「我的」页样式。
 * 页面可使用 app.wxss 的 token 与工具类（.card/.btn-primary/.btn-ghost/.tag/.empty）；
 * 这里只补页面自己的布局与会员卡样式。
 * 安全区：page 的 padding-bottom 必须与元素自身 padding 合并在同一条声明里
 * （见 app.wxss 末尾注释），此处用 .page 的 padding-bottom 一并处理。 */

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(var(--tabbar-h) + 32rpx);
  box-sizing: border-box;
  background: var(--bg);
}

/* ---- 加载 / 错误态 ---- */

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 120rpx 0;
  color: var(--ink-3);
  font-size: 26rpx;
}

.state-err {
  color: var(--ink-2);
}

.spinner {
  width: 68rpx;
  height: 68rpx;
  border: 6rpx solid #ffe3d4;
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ---- 会员卡 ---- */

.card {
  margin-bottom: 24rpx;
}

/* 已登录：品牌渐变卡 */
.cardOn {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
  background: var(--grad-brand);
  color: #fff;
  box-shadow: var(--shadow-2);
}

/* 未登录：占位引导卡。用品牌浅色渐变底代替生硬的虚线框，
   视觉上向登录后的品牌渐变卡靠拢，更像「会员引导」而非「报错提示」 */
.cardOff {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #fff7f2 0%, #ffeee2 100%);
  border: 2rpx solid rgb(240 72 31 / 10%);
  box-shadow: 0 4rpx 16rpx rgb(240 72 31 / 6%);
}

.card-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgb(255 255 255 / 24%);
  font-size: 40rpx;
  font-weight: 600;
}

.card-avatar-off {
  background: #fff;
  color: var(--brand);
  box-shadow: 0 6rpx 18rpx rgb(240 72 31 / 16%);
}

.card-main {
  flex: 1;
  min-width: 0;
}

.card-name {
  font-size: 34rpx;
  font-weight: 600;
  color: inherit;
}

/* 昵称行：昵称 + 「改名」同排，昵称长时由它收缩（.ellipsis），按钮不被挤出去 */
.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.edit-name {
  flex: none;
  padding: 2rpx 16rpx;
  border: 2rpx solid rgb(255 255 255 / 45%);
  border-radius: var(--r-pill);
  font-size: 20rpx;
  color: inherit;
}

.card-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgb(255 255 255 / 78%);
}

.cardOff .card-sub {
  color: var(--ink-3);
}

/* 未登录引导卡的右侧箭头：暗示整卡可点（点了即登录/注册） */
.card-arrow {
  flex: none;
  color: var(--ink-4);
  font-size: 40rpx;
  line-height: 1;
}

.card-stat {
  flex: none;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgb(255 255 255 / 78%);
}

/* ---- 储值余额 ---- */
.wallet-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
  background: var(--card);
  border-radius: 16rpx;
}

.wallet-label {
  flex: 1 1 auto;
  font-size: 26rpx;
  color: var(--ink-3);
}

.wallet-amount {
  font-size: 34rpx;
  font-weight: 700;
}

.wallet-action {
  font-size: 24rpx;
  color: var(--brand);
}

/* 「微信一键注册成为会员」文案较长，强制单行不换行；
   上下边距与卡片、储值余额行保持一致的呼吸感（24/32rpx 节奏） */
.btn-primary {
  margin: 8rpx 0 32rpx;
  white-space: nowrap;
}

/* 注册前的协议告知：紧跟主按钮下方，不抢视觉权重，但要看得见、点得到 */
.agree-line {
  margin: 0 0 32rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.8;
  color: var(--ink-3);
}

.agree-link {
  color: var(--brand);
}

/* 「修改昵称 / 退出登录」并排：两个都是低频次要操作，各占一半宽度更好点按。 */
.actions-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.btn-half {
  flex: 1 1 0;
  min-width: 0;
}

/* 注销入口：不做成按钮，避免与退出登录抢视觉权重；红色小字 + 底部留白。 */
.danger-zone {
  margin-top: 40rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--danger, #d54941);
}

/* ---- 历史订单 ---- */

.sec {
  margin-top: 8rpx;
}

.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.sec-sub {
  font-size: 22rpx;
  color: var(--ink-3);
}

.order {
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: var(--card);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-1);
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-table {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.order-mid {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.order-no {
  font-size: 24rpx;
  color: var(--ink-3);
}

.order-pickup {
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 20rpx;
}

.order-bot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.order-time {
  font-size: 22rpx;
  color: var(--ink-3);
}

.order-amt {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brand-deep);
}

/* 金额 + 箭头：箭头暗示整行可点（进入只读详情） */
.order-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.order-arrow {
  color: var(--ink-4);
  font-size: 30rpx;
  line-height: 1;
}

.btn-more {
  margin-top: 8rpx;
}
