/* 「我的」页样式。
 * 页面可使用 app.wxss 的 token 与工具类（.card/.btn-primary/.btn-ghost/.tag/.empty）；
 * 这里只补页面自己的布局与会员卡样式。
 * 安全区：page 的 padding-bottom 必须与元素自身 padding 合并在同一条声明里
 * （见 app.wxss 末尾注释），此处用 .page 的 padding-bottom 一并处理。 */

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(var(--tabbar-h) + 32rpx);
  box-sizing: border-box;
  background: var(--bg);
}

/* ---- 加载 / 错误态 ---- */

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 120rpx 0;
  color: var(--ink-3);
  font-size: 26rpx;
}

.state-err {
  color: var(--ink-2);
}

.spinner {
  width: 68rpx;
  height: 68rpx;
  border: 6rpx solid #ffe3d4;
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ---- 会员卡 ---- */

.card {
  margin-bottom: 24rpx;
}

/* 已登录：品牌渐变卡 */
.cardOn {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
  background: var(--grad-brand);
  color: #fff;
  box-shadow: var(--shadow-2);
}

/* 未登录：占位引导卡 */
.cardOff {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
  background: var(--card);
  border: 2rpx dashed var(--ink-4);
}

.card-avatar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgb(255 255 255 / 24%);
  font-size: 40rpx;
  font-weight: 600;
}

.card-avatar-off {
  background: var(--brand-soft);
  color: var(--brand-deep);
}

.card-main {
  flex: 1;
  min-width: 0;
}

.card-name {
  font-size: 34rpx;
  font-weight: 600;
  color: inherit;
}

.card-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgb(255 255 255 / 78%);
}

.cardOff .card-sub {
  color: var(--ink-3);
}

.card-stat {
  flex: none;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgb(255 255 255 / 78%);
}

.btn-logout {
  margin-bottom: 24rpx;
}

/* ---- 历史订单 ---- */

.sec {
  margin-top: 8rpx;
}

.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.sec-sub {
  font-size: 22rpx;
  color: var(--ink-3);
}

.order {
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: var(--card);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-1);
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-table {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.order-mid {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.order-no {
  font-size: 24rpx;
  color: var(--ink-3);
}

.order-pickup {
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 20rpx;
}

.order-bot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.order-time {
  font-size: 22rpx;
  color: var(--ink-3);
}

.order-amt {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brand-deep);
}

.btn-more {
  margin-top: 8rpx;
}
