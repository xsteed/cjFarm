.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  /* 为常驻的底部导航留出空间：tab-bar 是 fixed 定位、不参与布局，
     不留白的话最后一道菜会被压在导航下面。box-sizing 必须显式写，
     否则 padding 会加在 100vh 之外，被 overflow: hidden 裁掉。 */
  padding-bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
}

/* ---------- 加载 / 错误 ---------- */
.state {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 0 60rpx;
}

.state-text {
  color: var(--ink-3);
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.err-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 60rpx;
  font-weight: 700;
  line-height: 104rpx;
  text-align: center;
}

.retry {
  margin-top: 8rpx;
}

/* ---------- 加载骨架屏 ----------
   按真实布局铺一遍（渐变头部 + 搜索 + 左栏 + 菜品行），加载完成时不会整页跳。
   白色区域的灰条用横向流光，头部在渐变底上改用透明度呼吸，避免灰底压在品牌色上。 */
.sk {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
}

.sk-bar {
  background: linear-gradient(90deg, #eef0f2 25%, #f8f9fa 37%, #eef0f2 63%);
  background-size: 400% 100%;
  animation: sk-sweep 1.4s ease infinite;
}

@keyframes sk-sweep {
  from {
    background-position: 100% 50%;
  }

  to {
    background-position: 0 50%;
  }
}

.sk-hero {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 40rpx 52rpx;
  background: linear-gradient(160deg, #ff6b35 0%, #f0481f 100%);
}

.sk-shop,
.sk-table {
  height: 40rpx;
  border-radius: var(--r-md);
  background: rgb(255 255 255 / 28%);
  animation: sk-pulse 1.3s ease-in-out infinite;
}

.sk-shop {
  width: 260rpx;
}

.sk-table {
  width: 120rpx;
  border-radius: var(--r-pill);
}

@keyframes sk-pulse {
  0%,
  100% {
    opacity: 0.55;
  }

  50% {
    opacity: 1;
  }
}

.sk-sheet {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
  margin-top: -32rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: #fff;
  overflow: hidden;
}

.sk-search {
  flex-shrink: 0;
  height: 72rpx;
  margin: 20rpx 24rpx;
  border-radius: var(--r-pill);
}

.sk-body {
  display: flex;
  flex: 1;
  min-height: 0;
}

.sk-cats {
  flex-shrink: 0;
  width: 180rpx;
  padding: 20rpx 20rpx 0;
  box-sizing: border-box;
  background: #fafafa;
}

.sk-cat {
  height: 36rpx;
  margin-bottom: 48rpx;
  border-radius: var(--r-sm);
}

.sk-dishes {
  flex: 1;
  min-width: 0;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}

.sk-dish {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
}

.sk-img {
  flex-shrink: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--r-md);
}

.sk-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
  padding-top: 8rpx;
}

.sk-line {
  height: 30rpx;
  border-radius: var(--r-sm);
}

.sk-line-short {
  width: 60%;
}

.sk-price {
  width: 140rpx;
  height: 36rpx;
  margin-top: auto;
  border-radius: var(--r-sm);
}

/* ---------- 品牌头部：店名 + 桌号压成一行 ----------
   原来店名与副标题占两行，垂直方向要吃掉 200rpx 左右；
   合成一行后省下的高度全给菜单，首屏能多看到大半道菜。
   底部仍留 52rpx：白色内容卡要上移 32rpx 盖住头部底边。 */
.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  flex-shrink: 0;
  padding: 28rpx 40rpx 52rpx;
  background: linear-gradient(160deg, #ff6b35 0%, #f0481f 100%);
  color: #fff;
}

.hero-shop {
  min-width: 0;
  overflow: hidden;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 桌号做成半透明胶囊：比跟在副标题里更醒目，顾客能随时确认自己没扫错桌 */
.hero-table {
  flex-shrink: 0;
  max-width: 280rpx;
  overflow: hidden;
  padding: 8rpx 22rpx;
  border-radius: var(--r-pill);
  background: rgb(255 255 255 / 20%);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 白色内容卡：上移盖住头部底边 ---------- */
.sheet-wrap {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
  margin-top: -32rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: #fff;
  overflow: hidden;
}

/* ---------- 搜索：固定在白卡顶部，不随菜单滚动 ---------- */
.search {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 16rpx;
  height: 72rpx;
  margin: 20rpx 24rpx 16rpx;
  padding: 0 24rpx;
  border-radius: var(--r-pill);
  background: #f5f5f5;
}

/* 放大镜：圆圈 + 45° 短柄 */
.search-ico {
  position: relative;
  flex-shrink: 0;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid var(--ink-3);
  border-radius: 50%;
  box-sizing: border-box;
}

.search-ico::after {
  position: absolute;
  right: -8rpx;
  bottom: -4rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--ink-3);
  transform: rotate(45deg);
  content: '';
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  color: var(--ink);
  font-size: 27rpx;
}

/* placeholder 的样式只能经 placeholder-class 传入（页面样式选不到它的伪元素） */
.search-ph {
  color: var(--ink-4);
  font-size: 27rpx;
}

.search-clear {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #d8d8d8;
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

/* 出餐提示条：文字与订单标签同一行，标签区横向滚动，再多订单也不撑高菜单区 */
.serving {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  padding: 20rpx 32rpx;
  border-bottom: 2rpx solid var(--line);
  background: var(--brand-ghost);
  color: var(--ink-2);
  font-size: 24rpx;
}

.serving-label {
  flex-shrink: 0;
}

/* scroll-view 横向滚动：白底胶囊不换行，超出部分右滑查看 */
.serving-chips {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.serving-chip {
  display: inline-block;
  margin-right: 12rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
  background: #fff;
  color: var(--brand-deep);
  font-size: 22rpx;
  box-shadow: 0 2rpx 8rpx rgb(240 72 31 / 12%);
}

/* ---------- 本店招牌：置顶分组下的横滑卡片条（与首页橱窗同款） ----------
   标题由上方吸顶的分组标题承担，这里只画卡片本体：品牌浅底圈出一块，
   与白底列表区分，也和招牌菜的品牌色呼应。
   position + z-index 是刻意的：给整条卡片建立一个低于吸顶标题（z-index 2）
   的层级上下文 —— 角标在条内仍是 z-index 2 压住售罄遮罩（1），
   但整条滑到吸顶标题底下时不会再盖到标题上（不建上下文的话，
   角标的 z-index 2 会与标题同级、按 DOM 顺序反盖上去）。 */
.sigstrip {
  position: relative;
  z-index: 1;
  margin: 12rpx 0 4rpx;
  padding: 16rpx 16rpx 14rpx;
  border-radius: var(--r-md);
  background: var(--brand-ghost);
}

.sigstrip-scroll {
  width: 100%;
  white-space: nowrap;
}

.sigstrip-row {
  display: inline-flex;
  gap: 20rpx;
}

.sigstrip-item {
  flex: none;
  width: 200rpx;
}

/* 图片圆角必须与角标的左上圆角同值（都是 --r-md）：角标圆角比图片大的话，
   角标会在左上角往里收，图片边缘露出一圈缝，看起来像没贴住（真机踩过）。
   与菜品行的 .dish-img（--r-md）也保持一致。 */
.sigstrip-media {
  position: relative;
  width: 200rpx;
  height: 150rpx;
  overflow: hidden;
  border-radius: var(--r-md);
  background: #f2f2f2;
}

/* 招牌角标：贴图片左上角，与菜品行的 .sig-tag 同视觉（品牌渐变 + 白字），
   左上圆角与图片圆角同值才能严丝合缝地贴在圆角上（见 .sigstrip-media 注释），
   右下收圆成对角，压在售罄遮罩之上（z-index 2 > 1），盖了遮罩仍认得出是招牌菜 */
.sigstrip-tag {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  padding: 2rpx 14rpx;
  border-radius: var(--r-md) 0 var(--r-md) 0;
  background: linear-gradient(135deg, var(--brand), var(--brand-deep));
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.sigstrip-img {
  display: block;
  width: 200rpx;
  height: 150rpx;
}

/* 没有图 / 图加载失败的占位：与真图同尺寸，避免卡片高度塌陷 */
.sigstrip-img-none {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-4);
  font-size: 20rpx;
}

.sigstrip-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgb(0 0 0 / 45%);
  color: #fff;
  font-size: 24rpx;
}

.sigstrip-name {
  margin-top: 12rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 价格行走 flex + 垂直居中：¥ / 价格 / 「起」字号不同（24 / 26 / 20rpx），
   按 inline 排会因基线差异看起来高低不齐（与首页 sig-price 同处理） */
.sigstrip-price {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  color: var(--brand-deep);
  font-size: 26rpx;
  font-weight: 700;
}

/* 「起」与价格之间留一点空隙：紧贴在一起会看成「48.00起」一个整体字（同首页） */
.sigstrip-from {
  margin-left: 6rpx;
  color: var(--ink-3);
  font-size: 20rpx;
  font-weight: 400;
}

/* ---------- 双栏：左分类 / 右菜品 ---------- */
.menu-body {
  display: flex;
  flex: 1;
  min-height: 0;
}

.cats {
  flex-shrink: 0;
  width: 180rpx;
  height: 100%;
  /* 底部留出结算栏的高度，否则最后一个分类会被它挡住点不到。
     导航与安全区的空间由 .page 的 padding-bottom 统一让出，这里只算结算栏。 */
  padding-bottom: 140rpx;
  box-sizing: border-box;
  background: #fafafa;
}

.cat {
  /* 角标的定位基准：分类项本身即包含块（高亮态的左条也要用，提到基类） */
  position: relative;
  padding: 28rpx 16rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.4;
  text-align: center;
}

.cat.on {
  background: #fff;
  color: var(--brand-deep);
  font-weight: 700;
}

/* 分类已点份数角标：固定在分类项右上角，与 H5 MenuView 的 .cat-badge 同款（px→rpx ×2） */
.cat-badge {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--brand), var(--brand-deep));
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.cat.on::before {
  position: absolute;
  top: 50%;
  left: 0;
  width: 8rpx;
  height: 36rpx;
  margin-top: -18rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: var(--brand);
  content: '';
}

/* 右栏吸顶标题的宿主：盖在 .dishes 之上，悬浮标题绝对定位于它的顶部 */
.dishes-wrap {
  position: relative;
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 0;
}

.dishes {
  flex: 1;
  min-width: 0;
  height: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* ---------- 分组标题：右栏所有分类连成一条，标题是分类之间的分隔 ----------
   吸顶：分类内容长的时候，滚到哪儿都能看见当前分类名（左侧高亮只在栏内可见，
   分类一多就滚出去了）。基础库不支持 sticky 时退化成普通标题，不影响功能。 */
.sec {
  position: sticky;
  top: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 12rpx;
  /* 负 margin + padding 把白底横向铺满，吸顶时两侧不会透出滚动的菜品 */
  margin: 0 -24rpx;
  padding: 22rpx 24rpx 12rpx;
  background: #fff;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 700;
}

.sec::before {
  width: 8rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: var(--grad-brand-soft);
  content: '';
}

/* ---------- JS 悬浮吸顶标题 ----------
   scroll-view 内 position:sticky 在部分基础库/机型上不生效（.sec 注释），改由
   onScroll 按 offsets 驱动：文案 = 当前分类；下一分类标题逼近顶部时 pinTop 变负
   （translateY 顶出视口），再由列表里真正的 .sec 自然接替 —— 「钉顶→菜品滚完→
   上移让位」不再依赖 sticky。外观与 .sec 完全一致，静止时与列表标题无缝重合 */
.sec-pin {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 12rpx;
  /* 宿主没有内边距，不需要 .sec 那个负 margin：直接铺满 + 同款左右 padding */
  padding: 22rpx 24rpx 12rpx;
  background: #fff;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 700;
}

.sec-pin::before {
  width: 8rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: var(--grad-brand-soft);
  content: '';
}

/* 空分类不占太多空间：提示一下就自然过渡到下一个分类 */
.empty-group {
  padding: 40rpx 0;
  color: var(--ink-3);
  font-size: 25rpx;
  text-align: center;
}

/* ---------- 菜品行 ---------- */
.dish {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

/* 图片区：加一层 wrapper 是为了让「售罄」遮罩能盖在图片/占位图上（相对定位） */
.dish-media {
  position: relative;
  flex-shrink: 0;
  width: 160rpx;
  height: 160rpx;
}

.dish-img {
  width: 100%;
  height: 100%;
  border-radius: var(--r-md);
  background: #f2f2f2;
}

/* 图片加载失败 / 没配图的占位：与真图同尺寸，避免整行高度塌陷 */
.dish-img-none {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-4);
  font-size: 22rpx;
}

/* 招牌角标：贴图片左上角，品牌色渐变底 + 白字（与 H5 op-signature 同视觉） */
.sig-tag {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  padding: 2rpx 14rpx;
  border-radius: var(--r-md) 0 var(--r-md) 0;
  background: linear-gradient(135deg, var(--brand), var(--brand-deep));
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 售罄：半透明遮罩盖住图片 + 居中「售罄」，即使没图/坏图也能一眼认出 */
.sold-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-md);
  background: rgb(26 26 26 / 55%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 售罄菜整体弱化：菜名变灰，价格保留但不可点 */
.dish.sold .dish-name {
  color: var(--ink-3);
}

/* 加菜提示条：从订单页点「加菜」回来时，说明这一轮会并入原单 */
.append-tip {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  border-radius: var(--r-md);
  background: rgba(255, 107, 53, 0.08);
  color: var(--warning);
  font-size: 24rpx;
  line-height: 1.5;
}

.dish-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.dish-name {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

/* 菜名后的小标签（已点 / 售罄 / 暂不可点）：三只共用一套盒子。
   行高写死 28rpx 而不是继承：继承来的 1.4 会随父级字号变，胶囊高度跟着变，
   配 vertical-align: middle 才能稳稳落在菜名的视觉中线上（原来用 3rpx 的魔法值，
   实际比菜名中心高约 6rpx）。 */
.tag-ordered,
.tag-off,
.tag-soldout {
  display: inline-block;
  margin-left: 12rpx;
  padding: 0 12rpx;
  height: 28rpx;
  border-radius: var(--r-pill);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
  vertical-align: middle;
}

/* 「已点 N」：加菜时提示这道已经在原单里，跟在菜名后比挤在按钮区更好扫 */
.tag-ordered {
  background: var(--warning-soft);
  color: #b7791f;
}

/* 没有规格可选（历史数据留下的菜）：这道菜根本下不了单，得说清楚 */
.tag-off {
  background: #f2f2f2;
  color: var(--ink-3);
}

/* 售罄：与「暂不可点」区分开（上架中但今天没了），用浅灰底 + 深灰字 */
.tag-soldout {
  background: #ececec;
  color: var(--ink-2);
}

/* ---------- 行内规格 chip：规格少时直接点选，不用进弹层 ---------- */
.spec-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.spec-chip {
  max-width: 200rpx;
  overflow: hidden;
  padding: 4rpx 16rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--r-pill);
  background: #fafafa;
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spec-chip.on {
  border-color: var(--brand);
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-weight: 600;
}

/* 售罄规格：灰显，点不动（onPickSpec 会再拦一道提示） */
.spec-chip.off {
  border-color: #eee;
  background: #f6f6f6;
  color: var(--ink-4);
}

.spec-soldout {
  margin-left: 6rpx;
  font-size: 18rpx;
  color: var(--ink-4);
}

.dish-desc {
  display: -webkit-box;
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--ink-3);
  font-size: 23rpx;
  line-height: 1.5;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dish-ft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.dish-price {
  color: var(--brand-deep);
  font-size: 34rpx;
  font-weight: 700;
}

.from {
  margin-left: 4rpx;
  color: var(--ink-3);
  font-size: 20rpx;
  font-weight: 400;
}

/* 无规格菜品的价格位：不显示 ¥0.00（那看起来像 bug），直接说明不可点 */
.dish-off {
  color: var(--ink-4);
  font-size: 24rpx;
  font-weight: 400;
}

/* 单规格菜品的规格名：让顾客知道这个价对应哪一档（与 H5 一致） */
.spec-name {
  margin-left: 6rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 400;
}

.dish-ops {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* ---------- 已选份数：单规格用步进器，多规格的份数挂在加号上 ---------- */
.stepper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 直径统一取 --ops-btn（56rpx ≈ 28px）：与下面单独那个加号同尺寸，
   这样一道菜「未点 → 已点」切换时按钮不会跳号。border-box 保证加減两个圆一样大。
   加减号不用字体里的「− / +」：那个字形跟着基线走，不同机型上下偏心，
   这里改成 CSS 画的圆角短棒（横棒共用，加号多一条竖棒），几何居中，
   与 H5 的 SVG 图标（stroke-width 2.5 / 24）同一粗细语言。 */
.st-btn {
  position: relative;
  flex-shrink: 0;
  width: var(--ops-btn);
  height: var(--ops-btn);
  border-radius: 50%;
  box-sizing: border-box;
}

/* 横棒：加减共用，50% + 负 margin 保证圆心对齐，不依赖字体行高 */
.st-btn::before {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 4rpx;
  margin: -2rpx 0 0 -10rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: '';
}

/* 竖棒：只给加号，与横棒交叉成「+」 */
.st-plus::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 4rpx;
  height: 20rpx;
  margin: -10rpx 0 0 -2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: '';
}

.st-minus {
  border: 2rpx solid #ffd5c4;
  background: #fff;
  color: var(--brand);
}

.st-plus {
  background: var(--grad-brand-soft);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgb(240 72 31 / 28%);
}

.st-num {
  min-width: 32rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

/* 单独那个加号：尺寸、图标笔画与步进器里的加号完全相同（都走 --ops-btn），
   点下去换成步进器时按钮大小不变。误触靠「点菜名也能开弹层」兜底，不靠放大按钮。
   加号同样是 CSS 画的两条短棒：字体的「+」跟着基线走，而 line-height 只能居中行盒。 */
.plus {
  position: relative;
  flex-shrink: 0;
  width: var(--ops-btn);
  height: var(--ops-btn);
  border-radius: 50%;
  background: var(--grad-brand-soft);
  box-shadow: 0 6rpx 18rpx rgb(240 72 31 / 28%);
}

.plus::before,
.plus::after {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 2rpx;
  background: #fff;
  content: '';
}

/* 横棒 */
.plus::before {
  width: 20rpx;
  height: 4rpx;
  margin: -2rpx 0 0 -10rpx;
}

/* 竖棒 */
.plus::after {
  width: 4rpx;
  height: 20rpx;
  margin: -10rpx 0 0 -2rpx;
}

/* 多规格菜品的份数：挂在加号右上角，不额外占一行宽度。
   必须 border-box：小程序没有全局 `box-sizing: border-box`，按 content-box 算的话
   30rpx(min-width) + 12rpx(padding) 会撑出个比 56rpx 按钮还宽的「角标」。 */
.plus-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: var(--r-pill);
  background: #fff;
  color: var(--brand-deep);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgb(240 72 31 / 30%);
}

/* 结算栏固定定位在导航之上，列表末尾留出等高空隙，避免最后一道菜被挡住 */
.list-pad {
  height: 140rpx;
}

/* ---------- 抛物线飞球：「+」加菜飞入购物车（与 H5 OrderPage.onFly 同款） ----------
   每次加菜由页面挂载一个新节点，位移量以内联 CSS 变量（--fx/--fy）注入，
   节点挂载即自动播放 keyframes —— 没有两段 setData 的首帧竞态，连点多球并行。
   外层 .fly-x 水平位移线性、中层 .fly-y 竖直位移缓入，叠加成抛物线；
   内层 .fly-core 是「小球包裹」本体，用纯 CSS keyframes 缩小。 */
.fly-x {
  position: fixed;
  /* 高于结算栏(20)，低于规格弹层/购物车半屏 */
  z-index: 50;
  pointer-events: none;
  /* 变量兜底定义：正常由内联 style 注入 */
  --fx: 0px;
  animation: fly-x-move 0.4s linear forwards;
  will-change: transform;
}

/* 中层只承担竖直位移（缓入），与外层线性水平位移叠加成抛物线 */
.fly-y {
  --fy: 0px;
  animation: fly-y-move 0.4s cubic-bezier(0.5, 0, 0.85, 0.42) forwards;
  will-change: transform;
}

/* 结算栏宿主：页面 JS 用它量购物车图标位置 / 拿组件实例，本身无需样式 */
.cart-bar-host {
  position: static;
}

.fly-core {
  width: 28rpx;
  height: 28rpx;
  /* 负外边距把球心对到坐标点上（left/top 对齐的是触点/图标中心，不是左上角） */
  margin: -14rpx 0 0 -14rpx;
  border-radius: 50%;
  /* 品牌渐变球 + 左上高光，与 cart-bar 的 --grad-brand-soft 同色系 */
  background: radial-gradient(circle at 30% 28%, #ffb27d 0%, #ff6b35 55%, #f0481f 100%);
  box-shadow: 0 4rpx 12rpx rgb(240 72 31 / 35%);
  animation: fly-shrink 0.4s ease-in forwards;
}

@keyframes fly-x-move {
  to {
    transform: translate(var(--fx), 0);
  }
}

@keyframes fly-y-move {
  to {
    transform: translate(0, var(--fy));
  }
}

@keyframes fly-shrink {
  0% {
    transform: scale(1.15);
  }

  70% {
    transform: scale(0.9);
  }

  100% {
    transform: scale(0.6);
    opacity: 0.6;
  }
}

/* ---------- 入座选人数：半透明蒙层 + 贴底面板（茶位费门店） ----------
   菜单照常渲染，蒙层只是盖在上面：顾客扫码后立刻看得到菜品，
   不会因为「什么都没有」而心烦。z-index 高于 tab-bar(30) / cart-bar(20)，
   低于规格弹层(100)——面板展示期间菜单点不了，两者不会同屏。 */
.person-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end; /* 面板贴底，不挡菜单主体 */
  background: rgb(0 0 0 / 45%);
  animation: person-fade 0.2s ease-out;
}

@keyframes person-fade {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

.person-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: #fff;
  box-shadow: 0 -16rpx 48rpx rgb(26 26 26 / 18%);
  animation: person-up 0.26s cubic-bezier(0.22, 0.9, 0.36, 1);
}

@keyframes person-up {
  from {
    transform: translateY(64rpx);
    opacity: 0.4;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 顶部拖拽条：纯装饰，暗示这是一张「底部抽屉」（与购物车抽屉同形态语言） */
.ps-grip {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #ebebeb;
}

.ps-title {
  margin-bottom: 10rpx;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-align: center;
}

/* 标题下的一行中性提示：只交代「选完就能点菜」这个下一步，
   不涉及金额（茶位费是购物车明细的职责），顾客不会误以为要另收费 */
.ps-hint {
  margin-bottom: 28rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  text-align: center;
}

/* 快捷人数 1~10：五列两行等宽格子。
   每格宽度 = (面板内容宽 − 4×16rpx 列距) / 5 ≈ 121rpx，高 88rpx：
   两位数也放得下，点按没有瞄准压力；选中走品牌橙描边 + 浅橙底。 */
.pg-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pg-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc((100% - 64rpx) / 5);
  height: 88rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  background: #fafafa;
  box-sizing: border-box;
  color: var(--ink-2);
  font-size: 30rpx;
  transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
}

.pg-cell.on {
  border-color: var(--brand);
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgb(240 72 31 / 16%);
}

/* 按压反馈：格子短暂加深（hover-class 指定，松手自动还原） */
.pg-cell-hover {
  border-color: #ffd5c4;
  background: #f2f2f2;
}

/* 步进器（左）+ 确认按钮（右）：统一 88rpx 行高，视线落在一条基线上 */
.ps-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
}

.pg-stepper {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 12rpx;
  height: 88rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--r-pill);
  background: #fafafa;
  box-sizing: border-box;
}

/* 加减号与菜品行的步进器同一套「CSS 短棒」画法：几何居中，不依赖字体基线 */
.pg-step {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: var(--brand-deep);
}

.pg-step::before {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24rpx;
  height: 4rpx;
  margin: -2rpx 0 0 -12rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: '';
}

/* 加号的竖棒：与横棒交叉成「+」 */
.pg-plus::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 4rpx;
  height: 24rpx;
  margin: -12rpx 0 0 -2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: '';
}

/* 到达边界（1 / 20）时按钮灰显，点击仍会触发但被 JS 收敛拦截 */
.pg-step.off {
  color: var(--ink-4);
}

.pg-num {
  min-width: 64rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

/* 还没选过：占位符弱化，提示这里可点（点数字拉起输入框） */
.pg-num.empty {
  color: var(--ink-4);
  font-size: 26rpx;
  font-weight: 400;
}

/* 确认按钮占满剩余宽度（高度沿用 .btn-primary 的 88rpx，与步进器对齐）；
   未选时的灰显走 app.wxss 的 .btn-primary.dim */
.pg-confirm {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
  font-size: 29rpx;
}

/* 按压反馈：按钮轻微下沉 */
.pg-btn-hover {
  transform: translateY(2rpx);
  opacity: 0.92;
}
