{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    // 必须用 node 解析：微信开发者工具的 TS 编译器不支持 bundler 模式
    // （src/tsconfig.json 由工具读取，extends 本文件）。
    "moduleResolution": "node",
    // lib 里的 DOM 是保守保留：本端源码不应使用浏览器 API（有 wx.* 全局类型），
    // 但 console 等全局声明的类型来自它；「误用浏览器 API」由 scripts/smoke.mjs
    // 兜底 —— 它在**没有 window/document 的环境**里逐个执行构建产物，能在构建期
    // 就抓到浏览器 API 泄漏（比类型检查更硬的保证）。
    "lib": ["ES2019", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    // verbatimModuleSyntax / isolatedModules 是 DevTools TS 编译器不支持的选项，
    // 不设置（源码本就统一用 import type，语义不受影响）。
    // wx.* 全局类型由 miniprogram-api-typings 提供（根 devDependencies）
    "types": ["miniprogram-api-typings"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
