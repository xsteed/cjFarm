# ============================================================================
# 扫码点餐管理系统 - 后端 systemd 服务单元
#
# 安装: 复制到 /etc/systemd/system/dining-backend.service
#       systemctl daemon-reload && systemctl enable --now dining-backend
#
# 说明: 工作目录设为安装目录, 后端据此读取 <INSTALL_DIR>/config.yaml, 并让相对路径
#       (./data/dining.db、旧版 ./uploads 导入源) 稳定可用;
#       端口/数据库/可信代理等部署配置都写在 config.yaml 里, 不必改本服务单元。
# ============================================================================

[Unit]
Description=Dining System Backend (扫码点餐管理系统后端)
After=network.target

[Service]
Type=simple
# 运行用户(建议非 root; 确保该用户对工作目录有读写权限)
User=dining
Group=dining

# 安装目录(与 deploy.sh 中 INSTALL_DIR 保持一致)
WorkingDirectory=/opt/dining-system
# 后端二进制
ExecStart=/opt/dining-system/bin/dining-backend

# 部署配置(端口 / 静态目录 / 数据库 / 日志 / 可信代理)统一在 <INSTALL_DIR>/config.yaml,
# 由 deploy.sh 生成并维护; 后端按 WorkingDirectory 自动读取, 因此本服务单元
# 不再声明任何配置项 —— 要改动请编辑该文件后 systemctl restart dining-backend。
#   · server.static_dir : 前端产物目录(默认 ../frontend/dist 是按「从 backend/ 启动」
#     设计的, 部署形态必须显式指定, deploy.sh 会写为 <INSTALL_DIR>/frontend/dist)
#   · server.port       : 监听端口(默认 8080)
#   · log.path          : 日志落盘路径(默认 ./logs/app.log, 相对工作目录)
#   · database.*        : SQLite / MySQL 连接
#
# EnvironmentFile 仅作为「逃生出口」保留: 想用环境变量临时覆盖某项配置时写在这里
# (环境变量优先级高于 config.yaml); 默认不存在, "-" 前缀保证缺失时不报错。
EnvironmentFile=-/etc/dining-backend.env

# ---- 切换到 MySQL(详见 docs/mysql-migration.md) ----
# 数据库连接写在 <INSTALL_DIR>/config.yaml 的 database 段。推荐用部署脚本改(自动重写该段):
#   sudo DB_DRIVER=mysql DB_HOST=10.0.0.9 DB_USER=dining \
#     DB_PASSWORD=xxx DB_NAME=dining bash deploy/deploy.sh --skip-build
# 也可以手工编辑 config.yaml 的 database 段, 然后 systemctl restart dining-backend。
#
# ⚠️ 不要在这里(或 /etc/dining-backend.env)再写 DB_*: 真实环境变量优先级高于 config.yaml,
#    会把你写在 config.yaml 里的配置顶掉, 表现为「改了 config.yaml 不生效」。
# 启动后核对实际后端:
#      journalctl -u dining-backend -n 200 | grep '已连接'
#    看到 "已连接 mysql 后端" 才算切换成功, 看到 sqlite 说明配置没生效。
#
# ⚠️ 主密钥 CONFIG_MASTER_KEY / data/master.key 必须与原库一致,否则已加密的
#    支付密钥无法解密;迁移时请一并复制 /opt/dining-system/data/master.key。
#
# 可信代理由 config.yaml 的 server.trusted_proxies 提供(deploy.sh 首次安装会自动写入),
# 一般无需在此声明。只有想用环境变量临时顶掉它时才解除注释(注意: 环境变量优先级更高):
# Environment=TRUSTED_PROXIES=127.0.0.1

# 崩溃自动重启
Restart=always
RestartSec=3

# 资源限制(可选)
# LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
