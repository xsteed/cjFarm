# ============================================================================
# 扫码点餐管理系统 — 后端环境变量模板
# ----------------------------------------------------------------------------
# 用法：复制为 backend/.env，程序启动时会自动读取【当前工作目录】下的 .env。
#       · 真实环境变量优先级更高，已存在的变量不会被文件覆盖；
#       · 文件不存在时静默跳过，单机 SQLite 部署可以完全不建该文件；
#       · 用 ENV_FILE 可指定其它路径（Windows 下请写 C:/path/.env 形式）。
# 本文件只含「默认值 / 占位符」，真实密码请勿提交到仓库。
#
# 备选方案：也可以改用 YAML 配置文件 backend/config.yaml（见 config.example.yaml），
# 分层可读、能写注释。两者功能等价、可共存，优先级为：
#   真实环境变量 > config.yaml > .env > 代码默认值
# 完整切换手册见 ../docs/mysql-migration.md
# ============================================================================

# 指定 .env 文件路径（默认 ./.env）
# ENV_FILE=./.env

# 指定 config.yaml 文件路径（默认 ./config.yaml；文件不存在则跳过）
# CONFIG_FILE=./config.yaml

# ---------------------------------------------------------------------------
# 1. HTTP 服务
# ---------------------------------------------------------------------------
# 监听端口（默认 8080）
PORT=8080
# 旧版本升级时的存量图片导入源目录（启动自动导入数据库后不再使用；运行时图片存储于数据库）（默认 ./uploads）
# UPLOAD_DIR=./uploads
# 前端构建产物目录（默认 ../frontend/dist）
# STATIC_DIR=../frontend/dist
# 跨域白名单，逗号分隔；默认不放开跨域（前后端同源部署无需配置）
# CORS_ORIGINS=https://order.example.com
# 可信代理 IP/CIDR，逗号分隔；经 Nginx 反代时必须配置，否则登录限流取不到真实客户端 IP
# TRUSTED_PROXIES=127.0.0.1

# ---------------------------------------------------------------------------
# 2. 数据库后端选择
# ---------------------------------------------------------------------------
# sqlite（默认，零依赖单机） | mysql
# 不填时：若设置了 DB_DSN 则按 mysql 处理，否则按 sqlite。
DB_DRIVER=sqlite

# ---- 2.1 SQLite（默认） ----
# 数据文件路径（默认 ./data/dining.db）
DB_PATH=./data/dining.db

# ---- 2.2 MySQL ----
# 方式 A（推荐）：直接给完整 DSN，设置后优先于下面的分项配置
# DB_DSN=root:密码@tcp(127.0.0.1:3306)/dining?charset=utf8mb4&parseTime=true&loc=Local&maxAllowedPacket=67108864
# 方式 B：分项配置，程序自动拼 DSN
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dining
# 附加参数（默认如下）；loc=Local 保证写入的时间字符串是本地时间，maxAllowedPacket 放行 5MB 图片写入
DB_PARAMS=charset=utf8mb4&parseTime=true&loc=Local&maxAllowedPacket=67108864

# ---------------------------------------------------------------------------
# 3. 敏感配置加密主密钥
# ---------------------------------------------------------------------------
# AES-256-GCM 主密钥，用于加密 tb_config 中的敏感项（如微信支付 APIv3 密钥）。
# 优先级：CONFIG_MASTER_KEY 环境变量 > MASTER_KEY_PATH 文件 > ./data/master.key（不存在则自动生成）。
# ⚠️ 迁移数据库时必须把原 data/master.key 一并带走，否则已加密的密钥无法解密。
# 支持格式：64 位十六进制 或 base64。留空则使用文件方式。
# CONFIG_MASTER_KEY=
# MASTER_KEY_PATH=./data/master.key
# 主密钥轮换：换用新主密钥而库里还是旧密钥加密的密文时，在这里声明旧密钥
# （格式同上），启动时自动把敏感配置改写为新密钥加密；完成后请删除本变量。
# MASTER_KEY_OLD=

# ---------------------------------------------------------------------------
# 4. 登录令牌 / 管理端账号
# ---------------------------------------------------------------------------
# 令牌有效期，单位小时（默认 24）
# TOKEN_TTL_HOURS=24
# 管理端初始账号（仅首次建库时写入，之后改密码请用系统内「修改密码」）
# ADMIN_USER=admin
# ADMIN_PASS=admin123

# ---------------------------------------------------------------------------
# 5. 打印代理
# ---------------------------------------------------------------------------
# 本地打印代理的初始令牌：仅当配置里 agent_token 为空时启动自动写入（幂等，
# 管理后台「系统配置 → 小票打印」保存后以后台值为准）。本地调试或容器部署
# 可在此预置，门店代理程序用同一令牌执行 <print-agent> --install 即可连通。
# 留空则需在管理后台手动生成。
# AGENT_TOKEN=

# ---------------------------------------------------------------------------
# 6. 安全加固
# ---------------------------------------------------------------------------
# 是否收紧主密钥文件 ACL（Windows 下用 icacls 仅保留当前用户；非 Windows 忽略）
# HARDEN_FILE_ACL=1

# ---------------------------------------------------------------------------
# 7. 日志
# ---------------------------------------------------------------------------
# 日志文件路径。不设置时默认 ./logs/app.log（相对进程工作目录），即开箱即落盘，
# 便于事后排障；设为 off / none / false / 0 / - 可关闭文件落盘（仅输出到控制台）。
# 生产用 systemd 部署时已在服务单元里固定为 <INSTALL_DIR>/logs/app.log。
# LOG_PATH=./logs/app.log
# 打印代理专属日志文件路径。默认 ./logs/agent.log：代理高频轮询的访问日志与
# 业务日志（含 pull 取单、「代理连接成功」）都写这里，排查代理问题只看此文件；
# 设为 off / none / false / 0 / - 时并入主日志文件（轮转策略复用 LOG_MAX_*）。
# LOG_AGENT_PATH=./logs/agent.log
# 日志级别 debug / info / warn / error（默认 info）
# LOG_LEVEL=info
# 文件轮转策略：单文件上限 MB（默认 50）、保留天数（默认 30）、历史文件数（默认 7，自动压缩）
# LOG_MAX_SIZE_MB=50
# LOG_MAX_AGE_DAYS=30
# LOG_MAX_BACKUPS=7
